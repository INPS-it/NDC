        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>regione azienda agricola</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>La regione dell'azienda agricola rappresenta un'entità geografico-amministrativa fondamentale per determinare la competenza territoriale e l'applicabilità di specifiche tutele emergenziali.</lexicalForm>
