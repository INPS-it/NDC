                <lexicalForm>data ultimo salvataggio istruttoria</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataUltimoSalvataggioIstruttoria</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Identifica il timestamp dell'ultimo aggiornamento o consolidamento dei dati effettuato dall'operatore di sede durante la fase di verifica individuale dei beneficiari. Questa proprietà traccia il momento in cui la posizione del lavoratore è stata salvata (temporaneamente o definitivamente), bloccando o rendendo disponibili i dati per la successiva trasmissione ai sistemi di pagamento centrali.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
