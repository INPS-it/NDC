        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataUltimoSalvataggioIstruttoria</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataUltimoSalvataggioIstruttoria</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
