              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/emanatoDa</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>emanato da</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
          </annotations>
        </iri>
