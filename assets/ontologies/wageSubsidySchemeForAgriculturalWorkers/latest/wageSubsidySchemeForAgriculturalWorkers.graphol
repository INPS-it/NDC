        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataPresentazioneDomandaCISOA</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataPresentazioneDomandaCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>data presentazione domanda CISOA</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataPresentazioneDomandaCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta la data esatta in cui l'azienda (o il suo intermediario) trasmette telematicamente il modello SR33 all'Istituto. Questo attributo è determinante per verificare il rispetto dei termini di invio previsti dalla norma (15 giorni dall'evento). Il sistema informatico utilizza questa data anche per contrassegnare lo stato della domanda come "OK" se presentata nei termini.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
