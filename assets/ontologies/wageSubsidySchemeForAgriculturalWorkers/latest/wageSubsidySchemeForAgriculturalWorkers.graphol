          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirezioneRegionaleINPS</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Direzione regionale INPS</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirezioneRegionaleINPS</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Struttura organizzativa territoriale dell’INPS che svolge funzioni di governo delle risorse assegnate, assicura la gestione complessiva dei processi istituzionali e di supporto, e verifica i livelli di qualità dei servizi e dei processi nelle strutture del territorio.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
