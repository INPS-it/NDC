        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompabilita</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompabilita</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>data compabilita</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompabilita</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta la data e l'ora in cui è stato aggiornato l'esito dei controlli di compatibilità per i beneficiari presenti in domanda. Poiché i controlli di compatibilità (che interrogano banche dati esterne) avvengono in modalità asincrona, la registrazione di questa data attesta il completamento delle verifiche tecniche necessarie all'operatore per procedere con l'istruttoria.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompilazioneDomandaCISOA</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompilazioneDomandaCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>data compilazione domanda CISOA</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompilazioneDomandaCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Indica la data in cui sono stati inseriti o aggiornati i dati della domanda sul portale "CISOA Web" prima dell'invio telematico. Corrisponde all'ultimo salvataggio effettuato dall'utente (azienda o consulente). È un dato fondamentale per la tracciabilità della pratica, in quanto il sistema richiede l'aggiornamento di questa data a ogni modifica apportata ai singoli quadri (A, B, C, ecc.).</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>data definizione ricorso CISOA</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta la data in cui viene emessa la deliberazione definitiva da parte del Comitato Amministratore. I termini per la decisione sono fissati in 90 giorni decorrenti dalla data di ricezione del ricorso attestata dal protocollo informatico, sebbene il Comitato conservi la potestà di decidere anche oltre tale scadenza.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDelibera</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDelibera</subject>
