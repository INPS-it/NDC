        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/statoControllo</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/statoControllo</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>stato controllo</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/statoControllo</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta la condizione in cui si trovano le verifiche automatiche effettuate dal sistema INPS interrogando banche dati esterne per ogni singolo lavoratore beneficiario. Tale controllo avviene in modalità asincrona e il suo esito è un prerequisito fondamentale per l'avanzamento del processo.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoMassimale</value>
          <annotations>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoMassimale</subject>
