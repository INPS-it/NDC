            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneComuneCantiereOFondo</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta il nome del comune in cui è ubicato il cantiere o il fondo agricolo presso cui operano i lavoratori e nel quale si è verificata la sospensione dell’attività. Si tratta di un dato geografico rilevante ai fini della valutazione dell’evento meteorologico eventualmente dichiarato.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
