                <lexicalForm>note esito istruttoria</lexicalForm>
                <datatype>http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral</datatype>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/noteEsitoIstruttoria</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Rappresenta il campo testuale utilizzato dall'Operatore di Sede per inserire annotazioni, giustificazioni o commenti tecnici relativi alla decisione assunta sul singolo lavoratore. Il suo utilizzo è obbligatorio in caso di reiezione individuale dell'istruttoria: l'operatore deve infatti motivare la negazione del pagamento qualora i controlli di compatibilità o le verifiche sui requisiti abbiano dato esito negativo.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
        <iri>
          <value>https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroBeneficiariDomandaCISOA</value>
