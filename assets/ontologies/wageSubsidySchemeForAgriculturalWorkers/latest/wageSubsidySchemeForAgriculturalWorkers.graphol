                <lexicalForm>Identifica l'assenza tramite un codice mnemonico a un carattere. Gli esempi includono: 'M' (malattia), 'F' (ferie), 'P' (permessi), 'MAT' (gravidanza e puerperio).</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
