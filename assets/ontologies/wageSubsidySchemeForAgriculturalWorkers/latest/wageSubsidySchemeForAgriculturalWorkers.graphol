              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Figura dirigenziale responsabile della direzione e del coordinamento operativo di una sede territoriale INPS, con competenza sui procedimenti e sui servizi attribuiti alla sede.</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
          </annotations>
        </iri>
