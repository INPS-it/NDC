    rdfs:domain INPSWSS:RicorsoCISOA ;
    rdfs:range INPSWSS:EsitoCommissioneProvinciale,
        [ a owl:Class ;
            owl:complementOf INPSWSS:AccoglimentoDomandaCISOA ] .

INPSWSS:ricorsoCISOApropostoDa a owl:ObjectProperty ;
