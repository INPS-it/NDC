    rdfs:domain INPSWSS:AutorizzazioneAziendaleDomandaCISOA,
        [ a owl:Class ;
            owl:complementOf INPSWSS:ReiezioneDomandaCISOA ] ;
    rdfs:range INPSWSS:IstruttoriaCISOA .

INPSWSS:autorizzazioneRiferitaADomanda a owl:ObjectProperty ;
