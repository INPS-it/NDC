INPSWSS: a owl:Ontology ;
    owl:versionIRI INPSWSS:1.0 ;
    owl:imports CLV:,
        COV:,
        l0:,
        RO:,
        TI: ;
    rdfs:label "INPS Ontology for the Italian Welfare Program CISOA (Wage subsidy scheme for agricultural workers)"@en,
        "Ontologia INPS relativa alla CISOA (Cassa Integrazione Speciale Operai Agricoli"@it ;
    rdfs:comment "INPS Ontology describing CISOA, the Italian income support scheme for employed agricultural workers in the event of a temporary suspension or reduction of work activity due to circumstances covered by the applicable legislation."@en,
        "L'ontologia INPS relativa alla CISOA, prestazione economica erogata a sostegno del reddito degli operai agricoli dipendenti in caso di sospensione o riduzione temporanea dell'attività lavorativa dovuta a eventi previsti dalla normativa vigente."@it ;
    owl:versionInfo "Version 1.0 - Modified on 29 July 2026"@en,
        "Versione 1.0 - Modificata il 29 Luglio 2026"@it ;
    rdfs:isDefinedBy INPSWSS: ;
    adms:acronym "inps" ;
    adms:hasContributor <https://w3id.org/italia/social-security/data/organization/td> ;
    adms:hasFormalityLevel adms:Formal ;
    adms:hasKeyClass INPSWSS:AziendaAgricola,
        INPSWSS:DomandaCISOA,
        INPSWSS:IstruttoriaCISOA,
        INPSWSS:LavoratoreInteressatoCISOA,
        INPSWSS:PrestazioneCISOA ;
    adms:hasOntologyLanguage adms:OWL ;
    adms:hasSemanticAssetDistribution <https://w3id.org/italia/social-security/data/wageSubsidySchemeForAgriculturalWorkers/distribution/WAGESUBSIDY-N-TRIPLES>,
        <https://w3id.org/italia/social-security/data/wageSubsidySchemeForAgriculturalWorkers/distribution/WAGESUBSIDY-RDF-TURTLE>,
        <https://w3id.org/italia/social-security/data/wageSubsidySchemeForAgriculturalWorkers/distribution/WAGESUBSIDY-RDF-XML> ;
    adms:hasTask adms:AnnotationTask,
        adms:QueryFormulationTask,
        adms:SearchTask ;
    adms:last INPSWSS:1.0 ;
    adms:officialURI "https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers"^^xsd:anyURI ;
    adms:prefix "INPSWSS" ;
    adms:semanticAssetInUse <https://w3id.org/italia/data/project/NDC> ;
    adms:status "catalogued",
        "published" ;
    adms:target "Cittadini"@it,
        "Imprese"@it,
        "Pubbliche Amministrazioni"@it ;
    adms:type adms:ServiceOnytology ;
    dcat:contactPoint <https://w3id.org/italia/social-security/data/organization/DirezioneCentraleTII> ;
    dcat:keyword "Azienda agricola"@it,
        "Domanda CISOA"@it,
        "Istruttoria CISOA"@it,
        "Lavoratore Interessato CISOA"@it,
        "Prestazione CISOA"@it,
        "Ricorso CISOA"@it ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/SOCI> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/IRREG> ;
    dct:creator <https://w3id.org/italia/social-security/data/organization/inps> ;
    dct:description "INPS Ontology describing CISOA, the Italian income support scheme provided to employed agricultural workers in the event of a temporary suspension or reduction of work activity due to circumstances covered by the applicable legislation."@en,
        "L'ontologia INPS relativa alla CISOA, prestazione economica erogata a sostegno del reddito degli operai agricoli dipendenti in caso di sospensione o riduzione temporanea dell'attività lavorativa dovuta a eventi previsti dalla normativa vigente."@it ;
    dct:identifier "https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers" ;
    dct:issued "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:language <http://publications.europa.eu/resource/authority/language/ENG>,
        <http://publications.europa.eu/resource/authority/language/ITA> ;
    dct:modified "2026-09-03T00:00:00+00:00"^^xsd:dateTime ;
    dct:publisher <https://w3id.org/italia/social-security/data/organization/inps> ;
    dct:rightsHolder <https://w3id.org/italia/social-security/data/organization/inps> ;
    dct:title "INPS Ontology for the Italian Welfare Program CISOA (Wage subsidy scheme for agricultural workers)"@en,
        "Ontologia INPS relativa alla CISOA (Cassa Integrazione Speciale Operai Agricoli"@it .

### Object Properties

INPSWSS:abilitaARuoloDiBeneficiarioCISOA a owl:ObjectProperty ;
    rdfs:label "abilita A ruolo di beneficiario CISOA"@it ;
    rdfs:domain INPSWSS:EsitoIstruttoriaCISOA,
        [ a owl:Class ;
            owl:complementOf INPSWSS:EsitoIstruttoriaRespinto ] ;
    rdfs:range INPSWSS:BeneficiarioCISOA .

INPSWSS:acquisitoTramiteProceduraD.I.C.A a owl:ObjectProperty ;
    rdfs:label "acquisito tramite procedura D.I.C.A"@it ;
    rdfs:domain INPSWSS:RicorsoCISOA ;
    rdfs:range <https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProceduraD.I.C.A.> .

INPSWSS:acquisizioneUtilizzaProceduraD.I.C.A a owl:ObjectProperty ;
