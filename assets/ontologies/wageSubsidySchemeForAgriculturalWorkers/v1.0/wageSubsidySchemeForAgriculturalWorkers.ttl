    rdfs:label "holds role in time"@it .

RO:withRole a owl:ObjectProperty .

### Datatypes

xsd:string a rdfs:Datatype .

### Data Properties

INPSCore:codiceSedeINPS a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice sede INPS"@it ;
    rdfs:domain INPSCore:SedeINPS .

INPSSafety:IBAN a owl:DatatypeProperty ;
    rdfs:domain INPSWSS:PagamentoDirettoINPS .

INPSWSS:altitudineCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "altitudine del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "Identifica l'altezza sopra il livello del mare del luogo fisico (cantiere o fondo) dove operano i lavoratori beneficiari. Si tratta di un'informazione di rilievo tecnico per la valutazione della domanda, in quanto può fornire alla Commissione Provinciale elementi di contesto necessari per accertare la veridicità di causali legate ad avversità atmosferiche (come gelo o neve) in relazione alla specifica collocazione geografica del sito lavorativo." .

INPSWSS:codiceDICARicorsoCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice DICA ricorso CISOA"@it ;
    rdfs:domain INPSWSS:RicorsoCISOA ;
    rdfs:comment "Rappresenta l'identificativo amministrativo univoco assegnato dal sistema informatico dell'Istituto nel momento in cui l'atto di impugnazione viene acquisito." .

INPSWSS:codiceDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Identifica univocamente la pratica amministrativa all'interno del sistema informativo INPS. " .

INPSWSS:codiceEsitoCompatibilita a owl:DatatypeProperty ;
    rdfs:label "codice esito compatibilita"@it ;
    rdfs:domain INPSWSS:ControlloDiCompatibilitaCISOA ;
    rdfs:comment "Rappresenta il codice numerico che sintetizza il risultato delle verifiche automatiche effettuate dal sistema interrogando basi dati esterne." .

INPSWSS:codiceEsitoDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice esito domanda CISOA"@it ;
    rdfs:domain INPSWSS:EsitoCommissioneProvinciale ;
    rdfs:comment "Rappresenta il valore codificato della decisione assunta dalla Commissione Provinciale in merito all'istanza aziendale. Questa proprietà può assumere i seguenti valori standard previsti dalla procedura:\"A\": Accolta (approvazione totale della richiesta).\"P\": Parzialmente accolta (approvazione di solo una parte del periodo o delle giornate).\"R\": Respinta (reiezione della domanda per mancanza di requisiti o causali non idonee)." .

INPSWSS:codiceEsitoIstruttoria a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice esito istruttoria"@en ;
    rdfs:domain INPSWSS:EsitoIstruttoriaCISOA ;
    rdfs:comment "Rappresenta il valore alfanumerico che identifica la decisione tecnica presa dall'Operatore di Sede per ogni singolo periodo richiesto dal lavoratore. I valori tipici sono:\"A\": Accolto (il pagamento per quel periodo è validato).\"R\": Respinto (il pagamento è negato a seguito dei controlli di compatibilità o mancanza di requisiti individuali). A differenza dell'esito della Commissione, questo codice determina l'effettiva liquidazione della prestazione al beneficiario." .

INPSWSS:codiceEsitoRicorsoCISOA a owl:DatatypeProperty ;
    rdfs:label "codice esito ricorso CISOA"@it ;
    rdfs:domain INPSWSS:DeliberaRicorsoCISOA ;
    rdfs:comment "Codifica le possibili risultanze del giudizio del Comitato attraverso i seguenti valori standard:C: Domanda accolta su ricorso.D: Domanda parzialmente accolta su ricorso.T: Domanda respinta su ricorso.U: L’esito della domanda resta confermato anche in seguito al ricorso.V: Domanda parzialmente respinta in seguito a ricorso." .

INPSWSS:codiceFiscaleAziendaAgricola a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice fiscale azienda agricola"@it ;
    rdfs:domain INPSWSS:AziendaAgricola ;
    rdfs:comment "Identifica il codice fiscale dell'azienda agricola." .

INPSWSS:codiceFiscaleLavoratoreInteressatoCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice fiscale lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Indica il codice alfanumerico univoco di 16 caratteri che identifica il lavoratore nei sistemi dell'Istituto." .

INPSWSS:codiceIdentificativoDenunciaAziendaleCIDA a owl:DatatypeProperty ;
    rdfs:label "codice identificativo denuncia aziendale CIDA"@it ;
    rdfs:domain INPSWSS:AziendaAgricola ;
    rdfs:comment "Il CIDA (Codice Identificativo Denuncia Aziendale) è un codice numerico univoco dell’azienda agricola, rilasciato dall'INPS, utilizzato per gli adempimenti previdenziali relativi alla manodopera agricola." .

INPSWSS:codiceSedeMembroCommissione a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice sede membro commissione"@it ;
    rdfs:domain INPSWSS:MembroCommissioneProvinciale ;
    rdfs:comment "Identifica in modo univoco l'ufficio territoriale INPS presso il quale opera un componente della Commissione CISOA." .

INPSWSS:codiceSedutaCommissioneProvinciale a owl:DatatypeProperty ;
    rdfs:label "codice seduta Commissione Provinciale" ;
    rdfs:domain INPSWSS:SedutaCommissioneProvinciale ;
    rdfs:comment "Rappresenta l'identificativo progressivo univoco assegnato a una specifica seduta della Commissione Provinciale presso una determinata sede INPS. " .

INPSWSS:codiceStatisticoContributivoCSC a owl:DatatypeProperty ;
    rdfs:label "codice statistico contributivo CSC"@it ;
    rdfs:domain INPSWSS:AziendaAgricola ;
    rdfs:comment "Il CSC (Codice Statistico Contributivo) è un codice numerico attribuito dall’INPS ai datori di lavoro per classificare l’azienda in base all’attività economica svolta e determinare il corretto inquadramento e le aliquote contributive applicabili; il CSC è inoltre usato per finalità statistiche e può essere associato ai codici di autorizzazione e al codice ATECO." .

INPSWSS:codiceStatoAcquisizioneDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice stato acquisizione domanda CISOA"@it ;
    rdfs:domain INPSWSS:StatoAcquisizioneDomandaCISOA ;
    rdfs:comment "Indica il valore alfanumerico. I codici principali sono:N: Nuova domanda (fase di bozza).P: Domanda presentata ad INPS.B: Trasmessa alla sede di presa in carico.C: Cancellata logicamente." .

INPSWSS:codiceTipoAssenza a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice tipo assenza"@it ;
    rdfs:domain INPSWSS:TipoAssenza ;
    rdfs:comment "Identifica l'assenza tramite un codice mnemonico a un carattere. Gli esempi includono: 'M' (malattia), 'F' (ferie), 'P' (permessi), 'MAT' (gravidanza e puerperio)." .

INPSWSS:codiceTipoAziendaAgricola a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice tipo azienda agricola"@it ;
    rdfs:domain INPSWSS:TipoAziendaAgricola ;
    rdfs:comment "Mappa la classificazione operativa del datore di lavoro, necessaria per determinare l'inquadramento contributivo corretto." .

INPSWSS:codiceTipoCausaleCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice tipo causale CISOA"@it ;
    rdfs:domain INPSWSS:TipoCausaleCISOA ;
    rdfs:comment "E' il codice alfanumerico univoco (tipicamente di 2 caratteri) che identifica una specifica causale di sospensione all'interno del sistema." .

INPSWSS:codiceTipoPagamentoCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "codice tipo pagamento CISOA"@it ;
    rdfs:domain INPSWSS:TipoPagamentoCISOA ;
    rdfs:comment "È la proprietà tecnica che mappa i valori utilizzati nei database INPS per identificare la modalità di erogazione. I valori codificati sono:D: Pagamento Diretto.C: Pagamento a Conguaglio." .

INPSWSS:contoTrattenuta a owl:DatatypeProperty ;
    rdfs:label "conto trattenuta"@it ;
    rdfs:domain INPSWSS:TrattenutaSindacalePrestazioneCISOA ;
    rdfs:comment "Identifica il conto di imputazione contabile necessario per indirizzare correttamente le somme trattenute verso la ragioneria." .

INPSWSS:dataAcquisizioneRicorso a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "data acquisizione ricorso CISOA"@it ;
    rdfs:domain INPSWSS:AcquisizioneRicorsoCISOA ;
    rdfs:comment "Indica la data in cui il soggetto legittimato presenta l'istanza di ricorso." .

INPSWSS:dataAssenzaFineLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "data assenza fine lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Indica la data di fine dell'eventuale assenza (es. termine del periodo di malattia o ferie) intervenuta a ridosso dell'inizio o della fine della sospensione CISOA." .

INPSWSS:dataAssenzaInizioLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "data assenza inizio lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Rappresenta la data di inizio di un'eventuale assenza del lavoratore (come malattia, infortunio o ferie) che coincide con l'inizio o con la fine del periodo di sospensione dell'attività lavorativa richiesto nella domanda." .

INPSWSS:dataCompabilita a owl:DatatypeProperty ;
    rdfs:label "data compabilita"@it ;
    rdfs:domain INPSWSS:ControlloDiCompatibilitaCISOA ;
    rdfs:comment "Rappresenta la data e l'ora in cui è stato aggiornato l'esito dei controlli di compatibilità per i beneficiari presenti in domanda. Poiché i controlli di compatibilità (che interrogano banche dati esterne) avvengono in modalità asincrona, la registrazione di questa data attesta il completamento delle verifiche tecniche necessarie all'operatore per procedere con l'istruttoria." .

INPSWSS:dataCompilazioneDomandaCISOA a owl:DatatypeProperty ;
    rdfs:label "data compilazione domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Indica la data in cui sono stati inseriti o aggiornati i dati della domanda sul portale \"CISOA Web\" prima dell'invio telematico. Corrisponde all'ultimo salvataggio effettuato dall'utente (azienda o consulente). È un dato fondamentale per la tracciabilità della pratica, in quanto il sistema richiede l'aggiornamento di questa data a ogni modifica apportata ai singoli quadri (A, B, C, ecc.)." .

INPSWSS:dataDefinizioneRicorsoCISOA a owl:DatatypeProperty ;
    rdfs:label "data definizione ricorso CISOA"@it ;
    rdfs:domain INPSWSS:DeliberaRicorsoCISOA ;
    rdfs:comment "Rappresenta la data in cui viene emessa la deliberazione definitiva da parte del Comitato Amministratore. I termini per la decisione sono fissati in 90 giorni decorrenti dalla data di ricezione del ricorso attestata dal protocollo informatico, sebbene il Comitato conservi la potestà di decidere anche oltre tale scadenza." .

INPSWSS:dataDelibera a owl:DatatypeProperty ;
    rdfs:label "data delibera"@it ;
    rdfs:domain INPSWSS:SedutaCommissioneProvinciale ;
    rdfs:comment "Rappresenta la data solare in cui si riunisce l'organo collegiale per esaminare le domande e assumere le decisioni di accoglimento, accoglimemto parziale o rigetto. " .

INPSWSS:dataFinePeriodoSospensione a owl:DatatypeProperty ;
    rdfs:label "data fine sospensione"@it ;
    rdfs:domain INPSWSS:PeriodoSospensione ;
    rdfs:comment "Identifica il giorno conclusivo dell'intervallo temporale in cui l'attività lavorativa è stata interrotta o ridotta per la causale indicata." .

INPSWSS:dataFineSospensioneLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "data fine sospensione lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Fine del periodo in cui il lavoratore ha sospeso l’attività." .

INPSWSS:dataInizioContrattoLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "data inizio contratto lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Indica la data in cui ha avuto inizio il contratto di lavoro a tempo indeterminato del lavoratore presso l'azienda agricola." .

INPSWSS:dataInizioPeriodoSospensione a owl:DatatypeProperty ;
    rdfs:label "data inizio sospensione"@it ;
    rdfs:domain INPSWSS:PeriodoSospensione ;
    rdfs:comment "Indica il giorno iniziale del periodo di fermo lavorativo oggetto della richiesta di integrazione salariale." .

INPSWSS:dataInizioSospensioneLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "data inizio sospensione lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Inizio del periodo in cui il lavoratore ha sospeso l’attività." .

INPSWSS:dataPresentazioneDomandaCISOA a owl:DatatypeProperty ;
    rdfs:label "data presentazione domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Rappresenta la data esatta in cui l'azienda (o il suo intermediario) trasmette telematicamente il modello SR33 all'Istituto. Questo attributo è determinante per verificare il rispetto dei termini di invio previsti dalla norma (15 giorni dall'evento). Il sistema informatico utilizza questa data anche per contrassegnare lo stato della domanda come \"OK\" se presentata nei termini." .

INPSWSS:dataRicezioneDomandaCISOA a owl:DatatypeProperty ;
    rdfs:label "data ricezione domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Rappresenta la data di presa in carico della domanda da parte della sede INPS territorialmente competente." .

INPSWSS:dataUltimoSalvataggioIstruttoria a owl:DatatypeProperty ;
    rdfs:label "data ultimo salvataggio istruttoria"@it ;
    rdfs:domain INPSWSS:IstruttoriaCISOA ;
    rdfs:comment "Identifica il timestamp dell'ultimo aggiornamento o consolidamento dei dati effettuato dall'operatore di sede durante la fase di verifica individuale dei beneficiari. Questa proprietà traccia il momento in cui la posizione del lavoratore è stata salvata (temporaneamente o definitivamente), bloccando o rendendo disponibili i dati per la successiva trasmissione ai sistemi di pagamento centrali." .

INPSWSS:descrizioneComuneCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "descrizione comune del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "Rappresenta il nome del comune in cui è ubicato il cantiere o il fondo agricolo presso cui operano i lavoratori e nel quale si è verificata la sospensione dell’attività. Si tratta di un dato geografico rilevante ai fini della valutazione dell’evento meteorologico eventualmente dichiarato." .

INPSWSS:descrizioneEsitoDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione esito domanda CISOA"@it ;
    rdfs:domain INPSWSS:EsitoCommissioneProvinciale ;
    rdfs:comment "Rappresenta l'etichetta testuale che esplicita la decisione finale assunta dalla Commissione Provinciale in merito alla domanda presentata dall'azienda." .

INPSWSS:descrizioneEsitoRicorso a owl:DatatypeProperty ;
    rdfs:label "descrizione esito ricorso"@it ;
    rdfs:domain INPSWSS:DeliberaRicorsoCISOA ;
    rdfs:comment "Rappresenta la specifica testuale della decisione finale assunta dal Comitato Amministratore della Gestione delle Prestazioni Temporanee." .

INPSWSS:descrizioneMansione a owl:DatatypeProperty ;
    rdfs:label "descrizione mansione"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Indica l'attività lavorativa o il ruolo professionale effettivamente svolto dal lavoratore al momento dell'inizio della sospensione dell'attività. Si tratta di una proprietà informativa obbligatoria da inserire nel Quadro F. Tale descrizione è necessaria per verificare se e in che modo l'evento sospensivo dichiarato abbia effettivamente inciso sull'attività svolta." .

INPSWSS:descrizioneMembroCommissioneProvinciale a owl:DatatypeProperty ;
    rdfs:label "descrizione membro commissione provinciale"@it ;
    rdfs:domain INPSWSS:MembroCommissioneProvinciale ;
    rdfs:comment "Rappresenta l'etichetta testuale o la qualifica associata a un componente dell'organo deliberante e descrive il ruolo specifico ricoperto dal membro durante la seduta, come \"Presidente\", \"Segretario\" o \"Rappresentante sindacale\". " .

INPSWSS:descrizioneSedutaCommissioneProvinciale a owl:DatatypeProperty ;
    rdfs:label "descrizione seduta Commissione Provinciale" ;
    rdfs:domain INPSWSS:SedutaCommissioneProvinciale ;
    rdfs:comment "Indica il nome o la denominazione testuale assegnata a una specifica seduta dell'organo collegiale. Questa proprietà permette di identificare la tipologia di riunione o il contesto in cui vengono esaminate le domande (ad esempio, \"Commissione Ordinaria\" o \"Commissione Straordinaria Emergenza Meteo\"). Serve a distinguere le diverse sessioni deliberative all'interno della medesima sede INPS e a facilitare la ricerca e la consultazione dei verbali storici." .

INPSWSS:descrizioneStatoAcquisizioneDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione stato acquisizione domanda CISOA"@it ;
    rdfs:domain INPSWSS:StatoAcquisizioneDomandaCISOA ;
    rdfs:comment "È la definizione testuale che spiega il significato del codice di stato. Ad esempio, per il codice P, la descrizione è \"la domanda è presentata ad INPS\"; per il codice B, è \"la domanda è trasmessa alla sede di presa in carico con i beneficiari\"." .

INPSWSS:descrizioneTipoAssenza a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione tipo assenza"@it ;
    rdfs:domain INPSWSS:TipoAssenza ;
    rdfs:comment "Identifica l' attributo testuale che riporta la denominazione estesa del tipo di assenza. Ad esempio: \"ASSENZA VOLONTARIA\", \"INFORTUNIO\" o \"SCIOPERO\"." .

INPSWSS:descrizioneTipoAziendaAgricola a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione tipo azienda agricola"@it ;
    rdfs:domain INPSWSS:TipoAziendaAgricola ;
    rdfs:comment "Rappresenta l'etichetta testuale estesa che identifica l'inquadramento giuridico e operativo del datore di lavoro." .

INPSWSS:descrizioneTipoCausaleCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione tipo causale CISOA"@it ;
    rdfs:domain INPSWSS:TipoCausaleCISOA ;
    rdfs:comment "Consiste nell'etichetta testuale estesa che illustra la motivazione della richiesta di integrazione salariale associata al relativo codice." .

INPSWSS:descrizioneTipoPagamentoCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "descrizione tipo pagamento CISOA"@it ;
    rdfs:domain INPSWSS:TipoPagamentoCISOA ;
    rdfs:comment "Rappresenta l'etichetta testuale associata al codice di pagamento, utilizzata nelle interfacce utente e nella modulistica per facilitare la comprensione. Le descrizioni standard sono \"Pagamento a Conguaglio\" e \"Pagamento Diretto\"." .

INPSWSS:flagEsenzione a owl:DatatypeProperty ;
    rdfs:label "flag esenzione"@it ;
    rdfs:domain INPSWSS:MassimaleCISOA ;
    rdfs:comment "Identifica la proprietà booleana che indica se una specifica causale è esente o meno dall'applicazione del limite massimo. Ad esempio, i trattamenti per \"intemperie stagionali\" sono esenti, mentre quelli per \"eccezionali calamità\" ne sono soggetti." .

INPSWSS:flagLavoratoreMensilizzato a owl:DatatypeProperty ;
    rdfs:label "flag lavoratore mensilizzato"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Rappresenta la proprietà tecnica che indica se il lavoratore è soggetto a retribuzione mensile oppure no." .

INPSWSS:flagMassimaleCausaleCISOA a owl:DatatypeProperty ;
    rdfs:label "flag massimale causale CISOA"@it ;
    rdfs:domain INPSWSS:CausaleCISOA ;
    rdfs:comment "Rappresenta un indicatore tecnico che specifica se, per una determinata motivazione di sospensione dell'attività lavorativa, sia previsto o meno l'utilizzo di un tetto massimo (massimale) all'erogazione della prestazione. Questa proprietà può assumere i valori \"S\" (Sì) o \"N\" (No) e la sua funzione è fondamentale per guidare il motore di calcolo dell'INPS nella determinazione dell'importo dell'integrazione salariale lorda spettante ai beneficiari." .

INPSWSS:flagPensionatoLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "flag pensionato lavoratore interessato CISOA"@it ;
    rdfs:range xsd:string ;
    rdfs:comment "Indica un indicatore che specifica se il lavoratore è titolare di un trattamento pensionistico. Può assumere i valori \"S\" (Sì) o \"N\" (No) ed è rilevante per determinare l'importo di eventuali trattenute giornaliere da applicare sulla prestazione." .

INPSWSS:flagPresenzaMembro a owl:DatatypeProperty ;
    rdfs:label "flag presenza membro"@it ;
    rdfs:domain INPSWSS:MembroCommissioneProvinciale ;
    rdfs:comment "È un indicatore booleano che traccia l'effettiva partecipazione di un componente a una specifica riunione di commissione. Può assumere i valori \"S\" (Sì) o \"N\" (No). La corretta valorizzazione di questo flag è indispensabile per la validità legale della seduta e per la produzione della \"Lettera per la Ragioneria\"." .

INPSWSS:flagSospensioneIstruttoria a owl:DatatypeProperty ;
    rdfs:label "flag sospensione istruttoria"@it ;
    rdfs:domain INPSWSS:IstruttoriaCISOA ;
    rdfs:comment "È una proprietà di tipo booleano o di stato che indica se l'attività di verifica tecnica su un singolo beneficiario è stata temporaneamente congelata dall'Operatore di Sede. All'interno dell'applicativo, l'operatore può inserire la spunta di \"Sospesa\" per segnalare la necessità di approfondimenti istruttori o per attendere l'esito di controlli asincroni critici, come la verifica di titolarità dell'IBAN (che può richiedere fino a tre giorni). Finché questo flag è attivo, la domanda rimane nello stato tecnico di \"Sospesa\" e il sistema non permette il passaggio alla fase finale di trasmissione o di effettuare ulteriori modifiche." .

INPSWSS:flagVisibileCausaleCISOA a owl:DatatypeProperty ;
    rdfs:label "flag visibile causale CISOA"@it ;
    rdfs:domain INPSWSS:CausaleCISOA ;
    rdfs:comment "E' un indicatore di sistema (Sì/No) utilizzato per gestire la visibilità della causale all'interno dell'applicazione web. Permette agli amministratori del sistema di rendere una causale selezionabile dalle aziende durante la fase di compilazione della domanda o di nasconderla qualora non sia più attiva o applicabile (come nel caso delle causali legate a decreti emergenziali scaduti)." .

INPSWSS:giornateAccolteLavoratore a owl:DatatypeProperty ;
    rdfs:label "giornate accolte lavoratore"@it ;
    rdfs:domain INPSWSS:IstruttoriaCISOA ;
    rdfs:comment "Rappresenta il numero di giornate di sospensione effettivamente validate dall'Operatore di Sede per il pagamento a un singolo lavoratore. Il valore viene determinato durante la fase di istruttoria individuale e non può essere superiore al numero di giorni approvato dalla Commissione Provinciale per l'azienda." .

INPSWSS:giornateRespinteLavoratore a owl:DatatypeProperty ;
    rdfs:label "giornate respinte lavoratore"@it ;
    rdfs:domain INPSWSS:IstruttoriaCISOA ;
    rdfs:comment "Identifica il numero di giornate di integrazione salariale richieste dall'azienda ma negate dall'INPS in fase di istruttoria tecnica per lo specifico lavoratore. Questa proprietà viene valorizzata qualora l'operatore riscontri anomalie o incompatibilità soggettive (es. lavoratore pensionato, decesso o mancato raggiungimento del requisito delle 181 giornate). In caso di valorizzazione di questa proprietà, l'operatore è tenuto a inserire una causale di reiezione individuale nel sistema." .

INPSWSS:importoTrattenuta a owl:DatatypeProperty ;
    rdfs:label "importo trattenuta"@it ;
    rdfs:domain INPSWSS:TrattenutaSindacalePrestazioneCISOA ;
    rdfs:comment "Identifica la proprietà di tipo decimale che indica il valore monetario esatto della trattenuta da sottrarre alla prestazione spettante al beneficiario." .

INPSWSS:indirizzoCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "indirizzo del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "Rappresenta l'ubicazione fisica esatta (recapito) del fondo agricolo o del cantiere dove viene svolta l'attività lavorativa e dove si è verificato l'evento che ha causato la sospensione." .

INPSWSS:indirizzoEmailAziendaAgricola a owl:DatatypeProperty ;
    rdfs:label "indirizzo email azienda agricola"@it ;
    rdfs:domain INPSWSS:AziendaAgricola ;
    rdfs:comment "Identifica l'indirizzo email dell'azienda agricola" .

INPSWSS:matricolaOperatoreDiSede a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "matricola operatore di sede"@it ;
    rdfs:domain INPSWSS:OperatoreDiSedeINPS ;
    rdfs:comment "Identifica in modo univoco il codice identificativo (matricola) del funzionario INPS che ha effettuato la lavorazione della pratica." .

INPSWSS:nomeAllegato a owl:DatatypeProperty ;
    rdfs:label "nome allegato"@it ;
    rdfs:domain INPSWSS:DocumentoAllegatoCISOA ;
    rdfs:comment "Rappresenta il nome del file elettronico caricato a corredo della domanda CISOA." .

INPSWSS:noteEsitoIstruttoria a owl:DatatypeProperty ;
    rdfs:label "note esito istruttoria"@it ;
    rdfs:domain INPSWSS:EsitoIstruttoriaCISOA ;
    rdfs:comment "Rappresenta il campo testuale utilizzato dall'Operatore di Sede per inserire annotazioni, giustificazioni o commenti tecnici relativi alla decisione assunta sul singolo lavoratore. Il suo utilizzo è obbligatorio in caso di reiezione individuale dell'istruttoria: l'operatore deve infatti motivare la negazione del pagamento qualora i controlli di compatibilità o le verifiche sui requisiti abbiano dato esito negativo." .

INPSWSS:numeroBeneficiariDomandaCISOA a owl:DatatypeProperty ;
    rdfs:label "numero beneficiari domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Il numero beneficiari domanda CISOA, indica il totale dei lavoratori (operai o impiegati agricoli) inseriti dall'azienda all'interno della singola domanda di concessione." .

INPSWSS:numeroDipendentiCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "numero dipendenti del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "Rappresenta il numero complessivo di lavoratori (operai, impiegati e quadri) effettivamente in forza presso lo specifico cantiere o fondo agricolo oggetto della domanda. Si tratta di un dato statistico e ispettivo fondamentale, poiché permette all'INPS di verificare la coerenza tra la forza lavoro totale dell'unità lavorativa e il numero di beneficiari per i quali viene richiesta l'integrazione salariale." .

INPSWSS:numeroDomandaCISOA a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "numero domanda CISOA"@it ;
    rdfs:domain INPSWSS:DomandaCISOA ;
    rdfs:comment "Identifica il codice numerico univoco assegnato alla pratica dalla sede INPS territorialmente competente al momento dell'acquisizione. Questa proprietà è solitamente composta dalle ultime due cifre dell'anno solare seguite da un numero progressivo (es. 220052). A differenza del protocollo telematico nazionale, questo numero è il riferimento principale utilizzato dagli operatori di sede per la gestione del fascicolo cartaceo, la ricerca a sistema e il legame della domanda ai verbali della Commissione." .

INPSWSS:numeroGiorniAssenzaLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "numero giorni assenza lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Rappresenta il numero complessivo di giorni di assenza del lavoratore (per motivi quali malattia, maternità, infortunio, ecc.) verificatisi in concomitanza con i periodi di sospensione dell'attività lavorativa. " .

INPSWSS:numeroGiorniIntegrazioneSalarialeRichiestaLavoratoreInteressatoCISOA a owl:DatatypeProperty ;
    rdfs:label "numero giorni integrazione salariale richiesta lavoratore interessato CISOA"@it ;
    rdfs:domain INPSWSS:LavoratoreInteressatoCISOA ;
    rdfs:comment "Indica il numero totale di giornate di integrazione salariale richieste dall'azienda per lo specifico lavoratore. Tale valore non può essere superiore al numero totale di giorni di sospensione dell'attività lavorativa indicati nella domanda." .

INPSWSS:numeroGiorniSospensione a owl:DatatypeProperty ;
    rdfs:label "numero giorni sospensione"@it ;
    rdfs:domain INPSWSS:PeriodoSospensione ;
    rdfs:comment "Indica la quantità totale di giornate lavorative per le quali l'azienda richiede l'integrazione salariale all'interno del periodo di fermo indicato. È importante notare che, per il calcolo di questo valore, il sistema informativo INPS applica una logica automatica che esclude dal computo le domeniche e le festività nazionali ricadenti nel periodo di sospensione." .

INPSWSS:provinciaCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "provincia del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "Rappresenta la sigla della provincia in cui è ubicato il fondo agricolo o il cantiere dove si è verificato l'evento di sospensione." .

INPSWSS:regioneAziendaAgricola a owl:DatatypeProperty ;
    rdfs:label "regione azienda agricola"@it ;
    rdfs:domain INPSWSS:AziendaAgricola ;
    rdfs:comment "La regione dell'azienda agricola rappresenta un'entità geografico-amministrativa fondamentale per determinare la competenza territoriale e l'applicabilità di specifiche tutele emergenziali." .

INPSWSS:regioneCantiereOFondo a owl:DatatypeProperty ;
    rdfs:label "regione del cantiere o fondo"@it ;
    rdfs:domain INPSWSS:CantiereOFondo ;
    rdfs:comment "La regione dell'unita produttiva rappresenta un'entità geografico-amministrativa fondamentale per determinare l'applicabilità di specifiche tutele emergenziali." .

INPSWSS:statoControllo a owl:DatatypeProperty ;
    rdfs:label "stato controllo"@it ;
    rdfs:domain INPSWSS:ControlloDiCompatibilitaCISOA ;
    rdfs:comment "Rappresenta la condizione in cui si trovano le verifiche automatiche effettuate dal sistema INPS interrogando banche dati esterne per ogni singolo lavoratore beneficiario. Tale controllo avviene in modalità asincrona e il suo esito è un prerequisito fondamentale per l'avanzamento del processo." .

INPSWSS:tipoMassimale a owl:DatatypeProperty ;
    rdfs:label "tipo massimale"@it ;
    rdfs:domain INPSWSS:MassimaleCISOA ;
    rdfs:comment "Proprietà che distingue tra le diverse tipologie di tetto massimo previste dalla legge di Bilancio 2022 (L. 234/2021)." .

INPSWSS:tipoRicorsoCISOA a owl:DatatypeProperty ;
    rdfs:label "tipo ricorso CISOA"@it ;
    rdfs:domain INPSWSS:RicorsoCISOA ;
    rdfs:comment "Identifica la categoria del soggetto che ha proposto l'impugnazione contro il provvedimento della Commissione Provinciale. I valori ammessi sono codificati come segue:A (Azienda): identifica i ricorsi presentati dal datore di lavoro agricolo contro la reiezione (totale o parziale) della domanda.L (Lavoratore): identifica i ricorsi presentati dai singoli operai agricoli interessati dalla prestazione.S (INPS/Amministrazione): identifica i ricorsi presentati dai componenti della Commissione Provinciale (incluso il Direttore di Sede o suo delegato) che abbiano manifestato il proprio dissenso durante la votazione e abbiano richiesto l'inserimento a verbale della motivazione." .

INPSWSS:tipoTrattenuta a owl:DatatypeProperty ;
    rdfs:label "tipo trattenuta"@it ;
    rdfs:domain INPSWSS:TrattenutaSindacalePrestazioneCISOA ;
    rdfs:comment "Specifica la natura del calcolo della ritenuta. Può assumere i valori 'N' se applicata sul valore netto della prestazione o 'L' se applicata sull'importo lordo." .

INPSWSS:valoreMassimale a owl:DatatypeProperty ;
    rdfs:label "valore massimale"@it ;
    rdfs:domain INPSWSS:MassimaleCISOA ;
    rdfs:comment "Proprietà numerica che riporta il limite monetario annuo stabilito dall'INPS (tramite circolari dedicate) per la liquidazione delle prestazioni soggette a tetto." .

### Classes

CLV:Feature a owl:Class .

CPV:Person a owl:Class .

foaf:Document a owl:Class .

INPSCore:RuoloDiAgente a owl:Class ;
    rdfs:subClassOf l0:Agent .

INPSCore:SedeINPS a owl:Class ;
    rdfs:label "Sede inps"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSCore:codiceSedeINPS ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:responsabileAcquisizioneRicorso ;
            owl:someValuesFrom owl:Thing ] .

INPSSafety:Apprendista a owl:Class .

INPSSafety:BeneficiarioPrestazioneDiSostegnoAlReddito a owl:Class .

INPSSafety:DatoreDiLavoroAgricolo a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:ricorsoCISOApropostoDa ] ;
            owl:someValuesFrom owl:Thing ] .

INPSSafety:LavoratoreSubordinatoAgricolo a owl:Class .

INPSSafety:PrestazioneDiSostegnoAlReddito a owl:Class .

INPSWSS:AccoglimentoDomandaCISOA a owl:Class ;
    rdfs:label "Accoglimento domanda CISOA"@it ;
    rdfs:subClassOf INPSWSS:EsitoCommissioneProvinciale ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:ricorsoCISOApropostoContro ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta l'esito positivo totale della valutazione effettuata dalla Commissione Provinciale, la quale riconosce la validità della causa di sospensione per l'intero periodo richiesto dall'azienda. Tecnicamente identificato con il codice \"A\", questo esito funge da autorizzazione legale che permette alla domanda di passare allo stato \"Definita\" e abilita la successiva fase di istruttoria per il pagamento dei lavoratori." .

INPSWSS:AccoglimentoParzialeDomandaCISOA a owl:Class ;
    rdfs:label "Accoglimento parziale domanda CISOA"@it ;
    rdfs:subClassOf INPSWSS:EsitoCommissioneProvinciale ;
    rdfs:comment "Indica una decisione della Commissione Provinciale che approva solo una parte delle giornate di sospensione indicate nella domanda. Questo esito, codificato come \"P\", comporta spesso la suddivisione del periodo richiesto in più segmenti (periodi parziali) con esiti differenti, consentendo comunque l'erogazione della prestazione per le giornate effettivamente autorizzate." .

INPSWSS:AcquisizioneRicorsoCISOA a owl:Class ;
    rdfs:label "Acquisizione ricorso CISOA"@it ;
    rdfs:subClassOf INPSWSS:FaseContenziosoCISOA,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataAcquisizioneRicorso ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:haOutputFascicolo ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:responsabileAcquisizioneRicorso ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta la fase iniziale del contenzioso in cui il ricorso CISOA viene acquisito formalmente dalla Sede INPS territoriale tramite la procedura D.I.C.A., ai fini dell’avvio dell’istruttoria regionale." .

INPSWSS:AutorizzazioneAziendaleDomandaCISOA a owl:Class ;
    rdfs:label "Autorizzazione aziendale domanda CISOA"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:EsitoCommissioneProvinciale
                    INPSWSS:ProvvedimentoAutorizzativoCISOA ) ] ;
    rdfs:comment "Identifica la prima macro-fase del processo CISOA, finalizzata a verificare la sussistenza dei requisiti oggettivi in capo al datore di lavoro che presenta l'istanza. Durante questa fase, la commissione provinciale o la direzione INPS accertano la regolarità dell'inquadramento aziendale, l'ubicazione del fondo o cantiere, la congruità della causale indicata e del periodo di sospensione richiesto. L'esito positivo di questa fase è il presupposto necessario per procedere alla successiva valutazione dei singoli lavoratori beneficiari." .

INPSWSS:AziendaAgricola a owl:Class ;
    rdfs:label "Azienda agricola"@it ;
    rdfs:subClassOf INPSSafety:DatoreDiLavoroAgricolo,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:aziendaAgricolaSituataIn ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceFiscaleAziendaAgricola ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:haTipoAziendaAgricola ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:indirizzoEmailAziendaAgricola ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:regioneAziendaAgricola ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Soggetto destinatario della normativa CISOA che esercita attività agricola diretta come coltivazione del fondo, silvicoltura, allevamento di animali o trasformazione e alienazione di prodotti agricoli. La normativa include anche imprese appaltatrici o concessionarie di lavori di forestazione e consorzi di bonifica o irrigazione ed altre." .

INPSWSS:BeneficiarioCISOA a owl:Class ;
    rdfs:label "Beneficiario CISOA"@it ;
    rdfs:subClassOf CPV:Person,
        INPSSafety:BeneficiarioPrestazioneDiSostegnoAlReddito ;
    rdfs:comment "Operaio agricolo con contratto a tempo indeterminato (OTI), impiegato (compresi gli apprendisti di tutte le tipologie contrattuali) o quadro che, sospeso temporaneamente dal lavoro per cause non imputabili allo stesso o al datore di lavoro, ha diritto all'indennità sostitutiva della retribuzione. Per accedere alla prestazione, il lavoratore deve vantare almeno 181 giornate di effettivo lavoro annuo presso la stessa azienda, requisito che può essere derogato  in casi eccezionali, normativamente previsti." .

INPSWSS:CantiereOFondo a owl:Class ;
    rdfs:label "Cantiere o Fondo"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:altitudineCantiereOFondo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneComuneCantiereOFondo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:indirizzoCantiereOFondo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:numeroDipendentiCantiereOFondo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:provinciaCantiereOFondo ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:aziendaAgricolaSuddivisaInCantiereOFondo ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta il luogo fisico specifico (fondo agricolo, bosco, stalla o stabilimento di trasformazione) dove viene esercitata l'attività e dove si verifica la sospensione lavorativa. Ogni azienda può avere più unità lavorative, ciascuna identificata da un progressivo e caratterizzata da dati geografici propri (comune, altitudine) e da un numero specifico di dipendenti in forza." .

INPSWSS:CausaleCISOA a owl:Class ;
    rdfs:label "Causale CISOA"@it ;
    rdfs:comment "Identifica la motivazione oggettiva che ha determinato l'interruzione dell'attività lavorativa, classificata dal sistema INPS tramite codici specifici. Le causali includono intemperie stagionali (cod. 01), ristrutturazione aziendale (cod. 05), stasi stagionale (cod. 02) o mancanza di materie prime (cod. 04). A seconda della causale, può essere previsto l'utilizzo di massimali economici o specifiche deroghe normative." .

INPSWSS:ComitatoAmministratorePrestazioniTemporaneeAiLavoratoriDipendenti a owl:Class ;
    rdfs:label "Comitato amministratore della gestione delle prestazioni temporanee ai lavoratori dipendenti"@it ;
    rdfs:subClassOf INPSCore:RuoloDiAgente ;
    rdfs:comment "Organo collegiale dell’INPS incaricato della gestione e della decisione sui ricorsi in materia di cassa integrazioni guadagni edilizia, industria e agricoltura." .

INPSWSS:CommissioneProvinciale a owl:Class ;
    rdfs:label "Commissione provinciale"@it ;
    rdfs:subClassOf INPSCore:RuoloDiAgente,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:compostaDa ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Organo collegiale operante presso ogni sede INPS, composto da  membri di diritto (tipicamente funzionari INPS , come il Direttore di sede) e rappresentanti dei datori di lavoro e dei lavoratori designati dalle rispettive organizzazioni sindacali di categori più rappresentative operanti nella provincia. Ha la competenza decisionale esclusiva sulle domande CISOA, valutando se la sospensione sia giustificata dalla causale addotta. Le sue decisioni vengono formalizzate attraverso una Delibera e un Verbale di seduta, che costituiscono il fondamento giuridico per l'autorizzazione o il rigetto del trattamento di integrazione salariale." .

INPSWSS:ControlloDiCompatibilitaCISOA a owl:Class ;
    rdfs:label "Controllo di compatibilita CISOA"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceEsitoCompatibilita ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta un processo di verifica automatica e asincrona che il sistema INPS esegue interrogando diverse banche dati per rilevare anomalie o incompatibilità riguardanti i beneficiari inseriti in una domanda. Questi controlli analizzano segnali critici come la titolarità di pensioni, la validazione del codice fiscale su ARCA, lo stato di decesso del lavoratore o la presenza di altre domande sovrapposte nel medesimo periodo. L'esito del controllo può essere \"OK\" (nessuna anomalia), \"KO\" (anomalie bloccanti) o \"WARNING\" (segnalazioni di attenzione) e la sua disponibilità è un vincolo tecnico imprescindibile per permettere all'operatore di attivare la fase di istruttoria." .

INPSWSS:DecisioneComitatoRicorsoCISOA a owl:Class ;
    rdfs:label "Decisione comitato ricorso CISOA"@it ;
    rdfs:subClassOf INPSWSS:FaseContenziosoCISOA ;
    rdfs:comment "Costituisce l'atto finale e decisorio del procedimento amministrativo di impugnazione. La competenza spetta al Comitato Amministratore della Gestione delle Prestazioni Temporanee, che deve assumere una decisione definitiva tramite delibera entro il termine di 90 giorni dalla ricezione del ricorso." .

INPSWSS:DeliberaRicorsoCISOA a owl:Class ;
    rdfs:label "Delibera ricorso CISOA"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceEsitoRicorsoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataDefinizioneRicorsoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneEsitoRicorso ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Identifica la decisione finale assunta dal Comitato Amministratore in merito a un ricorso. L'esito determina se la richiesta di integrazione salariale debba essere accolta (totalmente o parzialmente) a seguito del riesame, oppure se debba essere confermata la decisione originaria della Commissione Provinciale. Tale esito cristallizza la posizione amministrativa dell'Istituto, avverso la quale è ammesso unicamente il ricorso al giudice ordinario." .

INPSWSS:DerogaProcedurale a owl:Class ;
    rdfs:label "Deroga procedurale"@it ;
    rdfs:subClassOf INPSWSS:GestionePraticaCISOA,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:prevedeProvvedimentoDirettore ;
            owl:someValuesFrom owl:Thing ] ;
    owl:disjointWith INPSWSS:ValutazioneCommissioneProvinciale ;
    rdfs:comment "Rappresenta un iter amministrativo eccezionale che modifica il percorso decisionale ordinario previsto dalla Legge 457/1972. In questo regime, la fase di valutazione non viene svolta dalla Commissione Provinciale, ma la domanda viene esaminata e autorizzata direttamente dalla direzione. Tale deroga si applica specificamente alle causali introdotte da normative d'urgenza, come nel caso delle intemperie stagionali previste dal D.L. 92/2025 per i periodi tra il 1° luglio e il 31 dicembre 2025." .

INPSWSS:DirettoreDiSedeINPS a owl:Class ;
    rdfs:label "Direttore di sede INPS"@it ;
    rdfs:subClassOf INPSCore:RuoloDiAgente ;
    rdfs:comment "Figura dirigenziale responsabile della direzione e del coordinamento operativo di una sede territoriale INPS, con competenza sui procedimenti e sui servizi attribuiti alla sede." .

INPSWSS:DirezioneRegionaleINPS a owl:Class ;
    rdfs:label "Direzione regionale INPS"@it ;
    rdfs:subClassOf INPSCore:RuoloDiAgente ;
    rdfs:comment "Struttura organizzativa territoriale dell’INPS che svolge funzioni di governo delle risorse assegnate, assicura la gestione complessiva dei processi istituzionali e di supporto, e verifica i livelli di qualità dei servizi e dei processi nelle strutture del territorio." .

INPSWSS:DocumentazioneIstruttoriaRicorso a owl:Class ;
    rdfs:label "Documentazione Istruttoria Ricorso"@it ;
    rdfs:subClassOf foaf:Document,
        [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:PropostaDeliberaRicorsoCISOA
                    INPSWSS:RelazioneIstruttoriaRicorsoCISOA ) ] ;
    rdfs:comment "Rappresenta l'insieme organico degli atti e delle prove documentali gestiti dalla Direzione Regionale durante la fase di esame del merito del ricorso." .

INPSWSS:DocumentoAllegatoCISOA a owl:Class ;
    rdfs:label "Documento allegato CISOA"@it ;
    rdfs:comment "Identifica ogni file digitale, tipicamente in formato PDF, che l'azienda trasmette a corredo della domanda telematica tramite il portale web. Gli allegati sono parte integrante del fascicolo elettronico e restano consultabili dagli operatori di sede durante le fasi di acquisizione, istruttoria e consultazione della pratica." .

INPSWSS:DomandaCISOA a owl:Class ;
    rdfs:label "Domanda CISOA"@it ;
    rdfs:subClassOf foaf:Document,
        l0:Object,
        [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:DomandaCISOADaDefinire
                    INPSWSS:DomandaCISOADefinita
                    INPSWSS:DomandaCISOAInCommissione
                    INPSWSS:DomandaCISOAInDeroga
                    INPSWSS:DomandaCISOAInTrasmissione
                    INPSWSS:DomandaCISOAPresentata ) ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:domandaCISOAPresentataDa ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:domandaCisoaRiferitaACantiereOFondo ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:haModalitaPagamentoCISOA ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:numeroDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    owl:disjointWith INPSWSS:RicorsoCISOA,
        INPSWSS:VariazioneModalitaPagamentoCISOA ;
    rdfs:comment "È l'istanza amministrativa fondamentale presentata telematicamente dalle aziende agricole per richiedere l'integrazione salariale speciale per i propri dipendenti sospesi temporaneamente dall'attività. L'entità è composta da diversi quadri informativi che raccolgono i dati del datore di lavoro, l'ubicazione del cantiere, la causale dell'evento atmosferico o aziendale e l'elenco analitico dei lavoratori. Ogni domanda è identificata univocamente da un numero di protocollo e da un progressivo di sede, seguendo un ciclo di vita che va dallo stato di \"Presentata\" fino alla \"Trasmessa\" per il pagamento." .

INPSWSS:DomandaCISOADaDefinire a owl:Class ;
    rdfs:label "Domanda CISOA da definire"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "Stato tecnico che indica che la seduta della Commissione si è conclusa, ma la domanda deve ancora essere lavorata dall'operatore di sede tramite l'inserimento materiale dell'esito (Accoglimento, Rigetto o Parziale) deliberato durante la riunione. Rappresenta un passaggio intermedio necessario prima della chiusura definitiva della commissione." .

INPSWSS:DomandaCISOADefinita a owl:Class ;
    rdfs:label "Domanda CISOA definita"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "Rappresenta lo stato della domanda una volta che la Commissione Provinciale è stata chiusa definitivamente con l'inserimento di tutti gli esiti. Per le domande con esito positivo (totale o parziale), questo stato costituisce il \"via libera\" per procedere alla successiva istruttoria tecnica sui requisiti individuali dei singoli lavoratori beneficiari." .

INPSWSS:DomandaCISOAInCommissione a owl:Class ;
    rdfs:label "Domanda CISOA in commissione"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "Identifica la fase in cui la domanda è stata inserita formalmente nell'Ordine del Giorno (ODG) di una seduta della Commissione Provinciale. In questo stato, la pratica è in attesa di essere esaminata dall'organo collegiale per la valutazione della validità della causale addotta." .

INPSWSS:DomandaCISOAInDeroga a owl:Class ;
    rdfs:label "Domanda CISOA in deroga"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "Rappresenta una specializzazione della richiesta di autorizzazione alla prestazione CISOA che segue un iter amministrativo e normativo eccezionale rispetto alla disciplina ordinaria della Legge 457/1972. A differenza delle domande standard, la cui competenza decisionale spetta alla Commissione Provinciale (organo collegiale), le domande in deroga per queste causali (come le intemperie stagionali previste dal D.L. 92/2025) vengono autorizzate direttamente dall’INPS. L'atto finale non è una delibera di commissione ma un provvedimento emanato dal Direttore della Struttura territorialmente competente." .

INPSWSS:DomandaCISOAInTrasmissione a owl:Class ;
    rdfs:label "Domanda CISOA in trasmissione"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "Indica che la fase di istruttoria individuale è terminata con successo e i dati della domanda sono stati validati e resi disponibili per l'invio ai database centrali dell'Istituto. Le domande in questo stato sono in attesa dell'elaborazione batch quotidiana che alimenta i sistemi contabili per la liquidazione della prestazione." .

INPSWSS:DomandaCISOAPresentata a owl:Class ;
    rdfs:label "Domanda CISOA presentata"@it ;
    rdfs:subClassOf INPSWSS:DomandaCISOA,
        TI:TimeIndexedEvent ;
    rdfs:comment "È lo stato iniziale in cui si trova la domanda subito dopo essere stata acquisita dagli archivi di sede. Indica che il file inviato dall'azienda è stato preso in carico dal sistema informativo della sede INPS territorialmente competente per l'avvio dell'iter di verifica." .

INPSWSS:EsitoCommissioneProvinciale a owl:Class ;
    rdfs:label "Esito Commissione Provinciale"@it ;
    rdfs:subClassOf INPSWSS:AutorizzazioneAziendaleDomandaCISOA,
        [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:AccoglimentoDomandaCISOA
                    INPSWSS:AccoglimentoParzialeDomandaCISOA
                    INPSWSS:ReiezioneDomandaCISOA ) ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceEsitoDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneEsitoDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    owl:disjointWith INPSWSS:ProvvedimentoAutorizzativoCISOA ;
    rdfs:comment "Rappresenta il verdetto tecnico e giuridico emesso dalla Commissione Provinciale al termine dell'esame di una domanda. Tale esito viene registrato nel sistema informativo con codici specifici: \"A\" per l'accoglimento totale, \"P\" per l'accoglimento parziale e \"R\" per la reiezione. La formalizzazione di un esito positivo (A o P) all'interno del Verbale della Commissione costituisce l'autorizzazione legale necessaria per abilitare le successive funzioni di istruttoria tecnica e procedere alla liquidazione delle somme ai lavoratori." .

INPSWSS:EsitoIstruttoriaAccolto a owl:Class ;
    rdfs:label "Esito istruttoria accolto"@it ;
    rdfs:subClassOf INPSWSS:EsitoIstruttoriaCISOA ;
    rdfs:comment "Rappresenta la conclusione positiva dell'istruttoria per un determinato beneficiario. Indica che il lavoratore ha superato con successo tutti i controlli di compatibilità e possiede i requisiti legali per ricevere l'indennità. Tecnicamente, questo esito abilita il calcolo dell'Integrazione Salariale Lorda (ISL) e la successiva trasmissione dei dati alla piattaforma pagamenti per la liquidazione." .

INPSWSS:EsitoIstruttoriaCISOA a owl:Class ;
    rdfs:label "Esito istruttoria CISOA"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:EsitoIstruttoriaAccolto
                    INPSWSS:EsitoIstruttoriaParzialmenteAccolto
                    INPSWSS:EsitoIstruttoriaRespinto ) ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceEsitoIstruttoria ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta il risultato finale della valutazione tecnica effettuata dall'operatore su ogni singolo lavoratore. A differenza dell'esito della Commissione (che riguarda l'evento aziendale), questo esito determina se il pagamento sarà effettivamente eseguito. Viene memorizzato a sistema e può differire da quanto stabilito nel verbale della commissione qualora emergano anomalie soggettive durante i controlli tecnici." .

INPSWSS:EsitoIstruttoriaParzialmenteAccolto a owl:Class ;
    rdfs:label "Esito istruttoria parzialmente accolto"@it ;
    rdfs:subClassOf INPSWSS:EsitoIstruttoriaCISOA ;
    rdfs:comment "Identifica una specifica tipologia di esito derivante dalla valutazione individuale dell'istruttoria. Si verifica quando:- L'operatore di sede decide di non approvare l'intero periodo richiesto per il lavoratore, ma solo una parte di esso, eventualmente suddividendolo in segmenti con risultati differenti.- Il numero delle giornate autorizzate viene ridotto rispetto a quelle richieste dall'azienda, spesso a causa di anomalie riscontrate nei controlli di compatibilità o per il superamento dei limiti massimi fruibili." .

INPSWSS:EsitoIstruttoriaRespinto a owl:Class ;
    rdfs:label "Esito istruttoria respinto"@it ;
    rdfs:subClassOf INPSWSS:EsitoIstruttoriaCISOA ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty INPSWSS:abilitaARuoloDiBeneficiarioCISOA ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Identifica la reiezione individuale di un lavoratore all'interno di una domanda che potrebbe essere stata accolta a livello aziendale. Questo esito si verifica quando i controlli di compatibilità rilevano impedimenti bloccanti (es. il lavoratore percepisce già una pensione incompatibile o è presente in altre domande sovrapposte). In questo caso, l'operatore è obbligato a inserire una nota testuale di giustificazione per motivare la negazione del pagamento nel sistema informativo." .

INPSWSS:FascicoloRicorsoCISOA a owl:Class ;
    rdfs:label "Fascicolo ricorso CISOA"@it ;
    rdfs:subClassOf foaf:Document,
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:haOutputFascicolo ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Identifica l'insieme organico dei documenti raccolti o generati durante la fase di acquisizione curata dalla Sede territoriale tramite la procedura D.I.C.A.. Esso comprende l'atto di ricorso presentato dal soggetto legittimato (azienda, lavoratore o membro dissenziente), il provvedimento impugnato e tutta la documentazione allegata, costituendo l'unità documentale che viene inoltrata alla Direzione Regionale per l'esame di merito." .

INPSWSS:FaseContenziosoCISOA a owl:Class ;
    rdfs:label "Fase Contenzioso CISOA"@it ;
    rdfs:subClassOf TI:TimeIndexedEvent ;
    rdfs:comment "Rappresenta il macro-processo dell'iter amministrativo del contenzioso che si attiva a seguito della deliberazione della Commissione provinciale relativa a una domanda CISOA. Questa classe organizza logicamente le attività di riesame dell'istanza, coordinando i passaggi procedurali e documentali che coinvolgono la Sede territoriale, la Direzione regionale e il Comitato Amministratore per giungere a una decisione definitiva in via amministrativa." .

INPSWSS:GestionePraticaCISOA a owl:Class ;
    rdfs:label "Gestione pratica CISOA"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:DerogaProcedurale
                    INPSWSS:ValutazioneCommissioneProvinciale ) ] ;
    rdfs:comment "Organizza il dominio in base alle diverse modalità di gestione della pratica previste dalla normativa e dalla prassi operativa, suddividendosi in due percorsi distinti:1. Valutazione commissione provinciale: identifica l'iter ordinario previsto dalla Legge 457/1972. In questo caso, la competenza decisionale spetta alla Commissione Provinciale, un organo collegiale che si riunisce per deliberare l'esito della domanda (accoglimento, rigetto o accoglimento parziale) sulla base degli ordini del giorno preparati dagli uffici.2. Deroga procedurale: rappresenta il percorso amministrativo eccezionale introdotto per far fronte a specifiche emergenze (come stabilito dal D.L. 92/2025 per le intemperie stagionali). In questo regime, le domande sono autorizzate direttamente dall’INPS tramite un provvedimento monocratico a cura del Direttore della Struttura territorialmente competente, bypassando il passaggio collegiale in Commissione per accelerare i tempi di sostegno al reddito." .

INPSWSS:IstruttoriaCISOA a owl:Class ;
    rdfs:label "Istruttoria CISOA"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:IstruttoriaConguaglioCISOA
                    INPSWSS:IstruttoriaPagamentoDirettoCISOA ) ] ;
    rdfs:comment "Rappresenta la fase di verifica tecnico-amministrativa individuale condotta dall'Operatore di Sede dell'INPS dopo che la Commissione Provinciale ha deliberato un esito positivo sulla domanda aziendale. In questa fase, l'operatore analizza la posizione di ogni singolo lavoratore per confermare il diritto alla prestazione, consultando i Controlli di Compatibilità asincroni (es. verifica pensioni o decesso) e validando i requisiti soggettivi. L'istruttoria può portare a un esito di accoglimento (totale o parziale) o a una reiezione individuale, potendo anche variare in diminuzione le giornate autorizzate rispetto alla delibera collegiale." .

INPSWSS:IstruttoriaConguaglioCISOA a owl:Class ;
    rdfs:label "Istruttoria conguaglio CISOA"@it ;
    rdfs:subClassOf INPSWSS:IstruttoriaCISOA ;
    owl:disjointWith INPSWSS:IstruttoriaPagamentoDirettoCISOA ;
    rdfs:comment "Rappresenta una specializzazione dell'istruttoria applicata alle domande per le quali l'azienda ha scelto il pagamento a conguaglio. In questa modalità, ordinaria per i lavoratori con la qualifica di operai, il datore di lavoro anticipa l'integrazione salariale ai lavoratori e successivamente recupera gli importi compensandoli con i contributi dovuti all'INPS. L'operatore, attraverso le funzioni di \"Istruttoria Conguaglio\", autorizza formalmente l'azienda a procedere con tale operazione dopo aver validato le posizioni individuali dei beneficiari." .

INPSWSS:IstruttoriaPagamentoDirettoCISOA a owl:Class ;
    rdfs:label "Istruttoria pagamento diretto CISOA"@it ;
    rdfs:subClassOf INPSWSS:IstruttoriaCISOA ;
    rdfs:comment "Identifica la fase istruttoria per le domande in cui l'INPS eroga la prestazione direttamente sul conto corrente del lavoratore. Questa modalità è obbligatoria per impiegati e quadri, o attivata per aziende in crisi di liquidità o cessazione di attività. Oltre ai controlli standard, questa fase richiede la verifica della destinazione del pagamento (codice IBAN) e l'accertamento della titolarità del conto, che può sospendere la pratica fino a tre giorni per i controlli interbancari." .

INPSWSS:IstruttoriaRicorsoCISOA a owl:Class ;
    rdfs:label "Istruttoria ricorso CISOA"@it ;
    rdfs:subClassOf INPSWSS:FaseContenziosoCISOA ;
    rdfs:comment "Rappresenta la fase di esame e preparazione della decisione, condotta dalla Direzione Regionale competente. In questa fase, l'ufficio regionale esamina nel merito le motivazioni del ricorso e la documentazione allegata, con l'obiettivo di produrre due documenti essenziali per il decidere: la relazione istruttoria e la proposta di delibera. Una volta completata questa analisi, la Direzione Regionale provvede a inoltrare l'intero fascicolo al Comitato Amministratore, per il tramite della Direzione centrale ,  per la risoluzione del caso." .

INPSWSS:LavoratoreInteressatoCISOA a owl:Class ;
    rdfs:label "Lavoratore Interessato CISOA"@it ;
    rdfs:subClassOf RO:Role,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceFiscaleLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataAssenzaFineLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataAssenzaInizioLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataFineSospensioneLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataInizioContrattoLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataInizioSospensioneLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneMansione ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:flagLavoratoreMensilizzato ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:flagPensionatoLavoratoreInteressatoCISOA ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions (
                            [ xsd:length "1"^^xsd:int ] ) ] ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:numeroGiorniAssenzaLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:numeroGiorniIntegrazioneSalarialeRichiestaLavoratoreInteressatoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:ricorsoCISOApropostoDa ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta l'operaio agricolo a cui si riferisce la domanda CISOA presentata dall’azienda, distinto dal beneficiario CISOA che ha già ottenuto il riconoscimento della prestazione." .

INPSWSS:MassimaleCISOA a owl:Class ;
    rdfs:label "Massimale CISOA"@it ;
    rdfs:comment "Rappresenta il limite massimo mensile di integrazione salariale erogabile per determinati trattamenti. La sua applicazione dipende dalla causale e dalla normativa vigente al momento della sospensione." .

INPSWSS:MembroCommissioneProvinciale a owl:Class ;
    rdfs:label "Membro commissione provinciale"@it ;
    rdfs:subClassOf CPV:Person,
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:compostaDa ] ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:ricorsoCISOApropostoDa ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Identifica i singoli componenti dell'organo deliberante, che includono membri di diritto (tipicamente funzionari INPS , come il Direttore di sede) e rappresentanti dei datori di lavoro e dei lavoratori designati dalle rispettive organizzazioni sindacali di categoria più rappresentative operanti nella provincia. Ogni sede gestisce una \"Commissione STANDARD\", i cui membri sono stabiliti da un apposito decreto di nomina. All'interno di una specifica seduta, il sistema distingue tra i membri teorici e i \"Partecipanti\" effettivamente presenti, la cui conferma è necessaria per la validità legale del verbale e per la generazione della documentazione per la Ragioneria." .

INPSWSS:OperatoreDiSedeINPS a owl:Class ;
    rdfs:label "Operatore di sede INPS"@it ;
    rdfs:subClassOf CPV:Person,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:matricolaOperatoreDiSede ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Figura professionale interna all'Istituto incaricata della lavorazione delle domande di competenza della propria sede territoriale. L'operatore svolge compiti decisivi quali la selezione manuale delle pratiche da sottoporre alla Commissione, la conduzione dell'istruttoria tecnica individuale su ogni beneficiario e la validazione finale dei dati per il pagamento. Ha inoltre la responsabilità di inserire a sistema gli esiti della delibera e di trasmettere i flussi contabili alla piattaforma pagamenti." .

INPSWSS:PagamentoAConguaglio a owl:Class ;
    rdfs:label "Pagamento A conguaglio"@it ;
    rdfs:subClassOf INPSWSS:TipoPagamentoCISOA ;
    owl:disjointWith INPSWSS:PagamentoDirettoINPS ;
    rdfs:comment "Rappresenta la modalità di erogazione in cui il datore di lavoro anticipa materialmente l'integrazione salariale ai lavoratori e successivamente recupera tali somme compensandole con i contributi previdenziali dovuti all'INPS. Questa modalità è tipica delle aziende di maggiori dimensioni ed è diventata obbligatoria per molti Contratti Collettivi Nazionali (CCNL) del settore agricolo a partire dal 2007. Il recupero degli importi deve essere effettuato dall'azienda, a pena di decadenza, entro 6 mesi dalla fine del periodo di paga o dalla data del provvedimento di concessione." .

INPSWSS:PagamentoDirettoINPS a owl:Class ;
    rdfs:label "Pagamento diretto INPS"@it ;
    rdfs:subClassOf INPSWSS:TipoPagamentoCISOA,
        [ a owl:Restriction ;
            owl:onProperty INPSSafety:IBAN ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta la modalità di erogazione in cui il datore di lavoro anticipa materialmente l'integrazione salariale ai lavoratori e successivamente recupera tali somme compensandole con i contributi previdenziali dovuti all'INPS. Questa modalità è diventata obbligatoria per i Contratti Collettivi Nazionali (CCNL) del settore agricolo (operai agricoli e florovivaisti e per gli addetti alla sistenazone idraulico-forestale e idarulico-agraria) a partire dal  1° ottobre 2007. Il  conguaglio o la richiesta di rimborso deve essere effettuato dall'azienda, a pena di decadenza, entro 6 mesi dalla fine del periodo di paga in corso alla scadenza del termine di durata della concessione o dalla data del provvedimento di concessione, se successiva." .

INPSWSS:PeriodoSospensione a owl:Class ;
    rdfs:label "Periodo sospensione"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:haCausaleCISOASpecificata ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta l'intervallo temporale, definito da una data di inizio e una data di fine, durante il quale l'attività lavorativa viene interrotta o ridotta per cause non imputabili al datore di lavoro o al dipendente. Il periodo è un elemento essenziale della domanda e deve essere riconducibile a una delle causali ammesse. Sulla base di questo arco temporale, il sistema calcola le giornate effettivamente integrabili, escludendo domeniche e festività nazionali." .

INPSWSS:PrestazioneCISOA a owl:Class ;
    rdfs:label "Prestazione CISOA"@it ;
    rdfs:subClassOf INPSSafety:PrestazioneDiSostegnoAlReddito,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:haDomandaCISOA ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Consiste nell'indennità sostitutiva della retribuzione erogata dall'INPS per tutelare il reddito dei lavoratori agricoli in caso di intemperie stagionali o altre cause non imputabili agli stessi o al datore di lavoro. Istituita dalla Legge 8 agosto 1972, n. 457, la prestazione spetta principalmente agli operai agricoli a tempo indeterminato (OTI), impiegati, quadri e apprendisti che possiedono i requisiti occupazionali previsti (almeno 181 giornate di lavoro annue presso la stessa azienda), fungendo da ammortizzatore sociale specifico per il settore primario." .

<https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProceduraD.I.C.A.> a owl:Class ;
    rdfs:label "Procedura D.I.C.A."@it ;
    rdfs:comment "Rappresenta lo strumento informatico e amministrativo, il cui acronimo significa Decentramento Istruttoria Contenzioso Amministrativo, utilizzato dalla Sede territoriale INPS per l’acquisizione formale dei ricorsi proposti avverso la deliberazione della Commissione provinciale relativa a una domanda CISOA. Esso funge da supporto tecnico per la presa in carico dell’istanza di impugnazione, garantendo il corretto instradamento della pratica verso la successiva fase di istruttoria regionale." .

INPSWSS:PropostaDeliberaRicorsoCISOA a owl:Class ;
    rdfs:label "Proposta delibera ricorso CISOA"@it ;
    rdfs:subClassOf INPSWSS:DocumentazioneIstruttoriaRicorso ;
    rdfs:comment "Costituisce l'atto formale conclusivo dell'istruttoria regionale con cui viene formulato un suggerimento specifico sull'esito da attribuire al contenzioso. Tale proposta viene trasmessa, unitamente alla relazione istruttoria, al Comitato Amministratore della Gestione delle Prestazioni Temporanee, che è il soggetto competente per l'emanazione della deliberazione definitiva." .

INPSWSS:ProvvedimentoAutorizzativoCISOA a owl:Class ;
    rdfs:label "Provvedimento autorizzativo CISOA"@it ;
    rdfs:subClassOf INPSWSS:AutorizzazioneAziendaleDomandaCISOA ;
    rdfs:comment "ll Provvedimento autorizzativo CISOA emanato dal Direttore di sede INPS rappresenta un atto amministrativo monocratico di autorizzazione che interviene in deroga all'iter ordinario di competenza della Commissione Provinciale. Questo provvedimento si configura come il risultato di una \"Deroga procedurale\" che bypassa la Commissione Provinciale per specifiche motivazioni normative, mantenendo però la stessa finalità di sblocco della pratica per l'erogazione della prestazione." .

INPSWSS:ReiezioneDomandaCISOA a owl:Class ;
    rdfs:label "Reiezione domanda CISOA"@it ;
    rdfs:subClassOf INPSWSS:EsitoCommissioneProvinciale ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty INPSWSS:autorizzazioneAziendalePositivaAttivaIstruttoria ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta l'esito negativo (diniego) deliberato dalla Commissione Provinciale, identificato tecnicamente con il codice \"R\". Si verifica quando l'organo collegiale accerta che non sussistono i presupposti legali o che le causali dichiarate (es. intemperie) non sono state tali da impedire l'attività lavorativa. La reiezione comporta l'invio di una comunicazione formale all'azienda." .

INPSWSS:RelazioneIstruttoriaRicorsoCISOA a owl:Class ;
    rdfs:label "Relazione istruttoria ricorso CISOA"@it ;
    rdfs:subClassOf INPSWSS:DocumentazioneIstruttoriaRicorso ;
    rdfs:comment "Identifica il documento di analisi tecnico-giuridica predisposto dalla Direzione Regionale a seguito dell'esame del ricorso e dei suoi allegati. Questo atto contiene una ricostruzione puntuale dei fatti e una valutazione di merito sull'istanza, fungendo da supporto conoscitivo e motivazionale necessario affinché l'organo collegiale possa assumere la decisione finale." .

INPSWSS:RicorsoCISOA a owl:Class ;
    rdfs:label "Ricorso CISOA"@it ;
    rdfs:subClassOf l0:Object,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceDICARicorsoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:tipoRicorsoCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta l’atto di opposizione amministrativa avverso la deliberazione di reiezione o di accoglimento parziale di una domanda emanata dalla Commissione Provinciale. Il ricorso può essere presentato dall’azienda, dai singoli lavoratori o dai membri della Commissione che abbiano espresso e verbalizzato il proprio dissenso durante la votazione. La presentazione deve avvenire entro 30 giorni dalla ricezione del provvedimento; la decisione definitiva spetta al Comitato Amministratore della Gestione delle Prestazioni Temporanee ai Lavoratori Dipendenti." .

INPSWSS:SedutaCommissioneProvinciale a owl:Class ;
    rdfs:label "Seduta Commissione provinciale"@it ;
    rdfs:subClassOf TI:TimeIndexedEvent,
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceSedutaCommissioneProvinciale ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:dataDelibera ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneSedutaCommissioneProvinciale ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta l'evento temporale specifico (riunione) in cui l'organo collegiale della Sede INPS si incontra per esaminare e deliberare sulle domande CISOA acquisite. Durante la preparazione di una seduta, l'operatore stabilisce la data della riunione, definisce l'Ordine del Giorno (ODG) con l'elenco delle pratiche da esaminare e identifica i componenti partecipanti. Una seduta può assumere forma ordinaria o speciale (ad esempio per eventi climatici eccezionali) e si conclude formalmente con la \"chiusura della commissione\" dopo l'inserimento di tutti gli esiti, rendendo i dati immodificabili e consultabili negli archivi storici." .

INPSWSS:StatoAcquisizioneDomandaCISOA a owl:Class ;
    rdfs:label "Stato acquisizione domanda CISOA"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceStatoAcquisizioneDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneStatoAcquisizioneDomandaCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Lo stato di acquisizione definisce la condizione amministrativa di una pratica telematica. Questa classificazione permette al sistema di gestire le fasi operative e di applicare i necessari controlli di validazione prima che la domanda diventi lavorabile dalla sede INPS competente." .

INPSWSS:TipoAssenza a owl:Class ;
    rdfs:label "Tipo assenza"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceTipoAssenza ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneTipoAssenza ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta la motivazione giuridica o amministrativa per cui un lavoratore può risultare assente all'inizio o alla fine del periodo di sospensione dell'attività lavorativa." .

INPSWSS:TipoAziendaAgricola a owl:Class ;
    rdfs:label "Tipo azienda agricola"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceTipoAziendaAgricola ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneTipoAziendaAgricola ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:haTipoAziendaAgricola ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Definisce la classificazione giuridica e operativa dell'azienda che presenta la domanda CISOA. È un componente fondamentale per determinare l'inquadramento e l'applicabilità della norma. I valori tecnici previsti dal sistema includono:CE: Conduzione in economia.CD: Coltivatore diretto.CM: Mezzadria o colonia.COOP: Cooperativa o consorzio agricolo.CB: Consorzio di bonifica o irrigazione.EF: Ente pubblico esercente forestazione.A: Altro." .

INPSWSS:TipoCausaleCISOA a owl:Class ;
    rdfs:label "Tipo causale CISOA"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceTipoCausaleCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneTipoCausaleCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta il raggruppamento delle motivazioni giuridico-normative che giustificano la richiesta di prestazione CISOA a seguito della sospensione o riduzione dell'attività lavorativa." .

INPSWSS:TipoControlloDiCompatibilità a owl:Class ;
    rdfs:label "Tipo controllo di compatibilità"@it ;
    rdfs:comment "Definisce le diverse tipologie di verifiche automatiche che il sistema INPS esegue sulla posizione individuale di ogni lavoratore agricolo indicato in domanda." .

INPSWSS:TipoPagamentoCISOA a owl:Class ;
    rdfs:label "Tipo pagamento CISOA"@it ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSWSS:PagamentoAConguaglio
                    INPSWSS:PagamentoDirettoINPS ) ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:codiceTipoPagamentoCISOA ;
            owl:someValuesFrom rdfs:Literal ],
        [ a owl:Restriction ;
            owl:onProperty INPSWSS:descrizioneTipoPagamentoCISOA ;
            owl:someValuesFrom rdfs:Literal ] ;
    rdfs:comment "Rappresenta la modalità con cui viene erogata l'indennità al lavoratore. Esistono due tipologie principali stabilite dalla prassi e dalla normativa:Pagamento Diretto: l'INPS eroga la prestazione direttamente sul conto corrente del lavoratore (tramite IBAN) o allo sportello postale. È la modalità standard per gli impiegati e i quadri, nei casi di cessazione o di mancanza di liquidità dell'azienda agricola. Pagamento a Conguaglio: l'azienda anticipa l'indennità al lavoratore e recupera l'importo compensandolo con i contributi dovuti all'Istituto. È la modalità ordinaria di pagamento nei confronti degli operai." .

INPSWSS:TrattenutaSindacalePrestazioneCISOA a owl:Class ;
    rdfs:label "Trattenuta sindacale prestazione CISOA"@it ;
    rdfs:comment "Rappresenta la deduzione monetaria operata sulla prestazione CISOA a seguito di una specifica delega sottoscritta dal lavoratore in favore di un'organizzazione sindacale." .

INPSWSS:ValutazioneCommissioneProvinciale a owl:Class ;
    rdfs:label "Valutazione Commissione Provinciale"@it ;
    rdfs:subClassOf INPSWSS:GestionePraticaCISOA ;
    rdfs:comment "È l'atto formale e ufficiale prodotto dalla Commissione Provinciale al termine di ogni seduta deliberativa. Il verbale \"cristallizza\" l'attività dell'organo collegiale, contenendo l'elenco dei membri partecipanti, le annotazioni della discussione e, soprattutto, l'esito definitivo (Accolta, Respinta o Parziale) per ciascuna domanda esaminata. All'interno del sistema, il verbale funge da documento di controllo e base legale per l'operatore di sede, che deve inserire i dati approvati prima di chiudere definitivamente la commissione e passare alla fase successiva." .

INPSWSS:ValutazioneIndividualeIstruttoriaCISOA a owl:Class ;
    rdfs:label "Valutazione individuale istruttoria CISOA"@it ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf INPSWSS:effettuaValutazioneIndividuale ] ;
            owl:someValuesFrom owl:Thing ] ;
    rdfs:comment "Rappresenta l'attività di verifica puntuale condotta dall'operatore di sede INPS su ogni singolo lavoratore agricolo inserito in una domanda CISOA già autorizzata dalla Commissione Provinciale." .

INPSWSS:ValutazioneRicorsoCISOA a owl:Class ;
    rdfs:label "Valutazione ricorso CISOA"@it ;
    rdfs:comment "Rappresenta l’attività di esame e ponderazione del ricorso amministrativo CISOA svolta dal Comitato amministratore della gestione delle prestazioni temporanee al fine di determinare l’esito finale del procedimento. La valutazione prende in considerazione il contenuto del ricorso, la documentazione istruttoria predisposta dalla Direzione regionale, la relazione istruttoria e la proposta di delibera, e conduce alla formulazione della delibera conclusiva del ricorso." .

INPSWSS:VariazioneModalitaPagamentoCISOA a owl:Class ;
    rdfs:label "Variazione modalita pagamento CISOA"@it ;
    rdfs:comment "Rappresenta l'entità che gestisce il cambiamento della forma di erogazione della prestazione (da conguaglio a pagamento diretto o viceversa) richiesto dopo la presentazione della domanda. Sebbene la modalità sia inizialmente scelta dall'azienda nel modello SR33, la variazione può essere richiesta tramite canali extra-procedurali (come la PEC) per motivi sopravvenuti, quali crisi di liquidità o cessazione dell'attività. Questa modifica viene gestita manualmente dall'operatore di sede all'interno dell'applicativo prima o durante la fase istruttoria." .

INPSWSS:VerbaleCommissioneProvinciale a owl:Class ;
    rdfs:label "Verbale commissione provinciale"@it ;
    rdfs:comment "È l'atto formale e ufficiale prodotto dalla Commissione Provinciale al termine di ogni seduta deliberativa. Il verbale \"cristallizza\" l'attività dell'organo collegiale, contenendo l'elenco dei membri partecipanti, le annotazioni della discussione e, soprattutto, l'esito definitivo (Accolta, Respinta o Parziale) per ciascuna domanda esaminata. All'interno del sistema, il verbale funge da documento di controllo e base legale per l'operatore di sede, che deve inserire i dati approvati prima di chiudere definitivamente la commissione e avviare i pagamenti." .

l0:Agent a owl:Class .

l0:Object a owl:Class .

RO:Role a owl:Class .

TI:TimeIndexedEvent a owl:Class .

