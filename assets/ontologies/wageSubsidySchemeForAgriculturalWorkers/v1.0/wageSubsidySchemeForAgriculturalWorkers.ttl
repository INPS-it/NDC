INPSWSS:ControlloArtigianoOCommerciante a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo artigiano o commerciante"@it ;
    rdfs:comment "Verifica se il lavoratore agricolo possiede una posizione contributiva aperta in altre gestioni autonome." .

INPSWSS:ControlloBeneficiarioDeceduto a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo beneficiario deceduto"@it ;
    rdfs:comment "Controllo anagrafico per verificare l'esistenza in vita del lavoratore." .

INPSWSS:ControlloCIG a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo CIG"@it ;
    rdfs:comment "Evita la doppia erogazione di ammortizzatori sociali (Cassa Integrazione Guadagni ordinaria o in deroga) nello stesso arco temporale." .

INPSWSS:ControlloDSWEB a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo DSWEB"@it ;
    rdfs:comment "Verifica la presenza di altre istanze di prestazione nel sistema di gestione delle domande web." .

INPSWSS:ControlloListaBLOCCHI a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo lista BLOCCHI"@it ;
    rdfs:comment "Controllo su liste speciali che inibiscono l'erogazione di prestazioni per motivi amministrativi o giudiziari." .

INPSWSS:ControlloMalattia a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo malattia"@it ;
    rdfs:comment "Rileva la sovrapposizione tra il periodo di sospensione richiesto e un'eventuale indennità di malattia." .

INPSWSS:ControlloPagamentiHubPNP a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo pagamenti hub PNP"@it ;
    rdfs:comment "Controllo relativo alla verifica di eventuali pagamenti riferiti a prestazioni previdenziali non pensionistiche, effettuato ai fini della valutazione di compatibilità della prestazione CISOA." .

INPSWSS:ControlloPensione a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo pensione"@it ;
    rdfs:comment "Controlla se il lavoratore percepisce già trattamenti pensionistici non cumulabili con l'integrazione salariale." .

INPSWSS:ControlloUnilav a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Controllo Unilav"@it ;
    rdfs:comment "Verifica se le comunicazioni obbligatorie dei datori di lavoro indicano rapporti di lavoro incompatibili con la CISOA." .

INPSWSS:SogliaRetribuzioneGiornaliera a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Soglia retribuzione giornaliera"@it ;
    rdfs:comment "Segnala l'impossibilità di calcolare correttamente la retribuzione di riferimento basandosi sui dati in possesso dell'Istituto." .

INPSWSS:ValidazioneCodiceFiscaleSuARCA a INPSWSS:TipoControlloDiCompatibilità,
        owl:NamedIndividual ;
    rdfs:label "Validazione codice fiscale su ARCA"@it ;
    rdfs:comment "Verifica la correttezza formale e la validità del codice fiscale negli archivi anagrafici INPS (ARCA)." .

### Axioms

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSSafety:DatoreDiLavoroAgricolo
            INPSWSS:LavoratoreInteressatoCISOA
            INPSWSS:MembroCommissioneProvinciale ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:AccoglimentoDomandaCISOA
            INPSWSS:AccoglimentoParzialeDomandaCISOA
            INPSWSS:ReiezioneDomandaCISOA ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:AcquisizioneRicorsoCISOA
            INPSWSS:DecisioneComitatoRicorsoCISOA
            INPSWSS:IstruttoriaRicorsoCISOA ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:BeneficiarioCISOA
            INPSWSS:MembroCommissioneProvinciale
            INPSWSS:OperatoreDiSedeINPS ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:ComitatoAmministratorePrestazioniTemporaneeAiLavoratoriDipendenti
            INPSWSS:CommissioneProvinciale
            INPSWSS:DirettoreDiSedeINPS
            INPSWSS:DirezioneRegionaleINPS ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:DocumentazioneIstruttoriaRicorso
            INPSWSS:DomandaCISOA
            INPSWSS:FascicoloRicorsoCISOA ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:DomandaCISOADaDefinire
            INPSWSS:DomandaCISOADefinita
            INPSWSS:DomandaCISOAInCommissione
            INPSWSS:DomandaCISOAInDeroga
            INPSWSS:DomandaCISOAInTrasmissione
            INPSWSS:DomandaCISOAPresentata ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:DomandaCISOADaDefinire
            INPSWSS:DomandaCISOADefinita
            INPSWSS:DomandaCISOAInCommissione
            INPSWSS:DomandaCISOAInDeroga
            INPSWSS:DomandaCISOAInTrasmissione
            INPSWSS:DomandaCISOAPresentata
            INPSWSS:FaseContenziosoCISOA
            INPSWSS:SedutaCommissioneProvinciale ) .

[] a owl:AllDisjointClasses ;
    owl:members (
            INPSWSS:EsitoIstruttoriaAccolto
            INPSWSS:EsitoIstruttoriaParzialmenteAccolto
            INPSWSS:EsitoIstruttoriaRespinto ) .

[] a owl:Restriction ;
    owl:onProperty INPSWSS:flagPensionatoLavoratoreInteressatoCISOA ;
    owl:someValuesFrom [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions (
                    [ xsd:length "1"^^xsd:int ] ) ] ;
    rdfs:subClassOf INPSWSS:LavoratoreInteressatoCISOA .

[] a owl:Restriction ;
    owl:onProperty RO:holdsRoleInTime ;
    owl:someValuesFrom INPSWSS:CommissioneProvinciale ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty INPSWSS:partecipaASeduta ;
            owl:someValuesFrom owl:Thing ] .

[] a owl:Restriction ;
    owl:onProperty RO:holdsRoleInTime ;
    owl:someValuesFrom [ a owl:Restriction ;
            owl:onProperty RO:withRole ;
            owl:someValuesFrom INPSWSS:LavoratoreInteressatoCISOA ] ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf (
                    INPSSafety:Apprendista
                    INPSSafety:LavoratoreSubordinatoAgricolo ) ] .

### Serialized using the ttlser deterministic serializer v1.2.0
