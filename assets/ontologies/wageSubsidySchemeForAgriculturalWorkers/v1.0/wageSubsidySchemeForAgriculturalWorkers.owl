        <rdfs:label xml:lang="it">Controllo malattia</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloPagamentiHubPNP -->

