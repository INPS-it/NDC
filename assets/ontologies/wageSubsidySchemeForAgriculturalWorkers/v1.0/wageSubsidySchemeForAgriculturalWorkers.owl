    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/core/SedeINPS -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/core/SedeINPS">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/responsabileAcquisizioneRicorso"/>
