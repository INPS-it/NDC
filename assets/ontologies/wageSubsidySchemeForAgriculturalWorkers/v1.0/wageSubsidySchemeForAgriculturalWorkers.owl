    <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/italia/onto/RO/holdsRoleInTime"/>
        <owl:someValuesFrom rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CommissioneProvinciale"/>
        <rdfs:subClassOf>
            <owl:Restriction>
