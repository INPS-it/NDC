            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/italia/onto/RO/holdsRoleInTime"/>
        <owl:someValuesFrom>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/onto/RO/withRole"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
            </owl:Restriction>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/Apprendista"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/LavoratoreSubordinatoAgricolo"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPensionatoLavoratoreInteressatoCISOA"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:length rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</xsd:length>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
    </owl:Restriction>
