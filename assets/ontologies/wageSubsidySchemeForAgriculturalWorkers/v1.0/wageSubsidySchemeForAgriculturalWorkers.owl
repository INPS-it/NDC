    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/trattenutaApplicataABeneficiario -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/trattenutaApplicataABeneficiario">
