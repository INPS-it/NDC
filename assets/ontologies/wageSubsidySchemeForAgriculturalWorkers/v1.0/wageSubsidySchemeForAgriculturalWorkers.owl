            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="it">Sede inps</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/Apprendista -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/Apprendista"/>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/BeneficiarioPrestazioneDiSostegnoAlReddito -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/BeneficiarioPrestazioneDiSostegnoAlReddito"/>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/DatoreDiLavoroAgricolo -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/DatoreDiLavoroAgricolo">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoDa"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/LavoratoreSubordinatoAgricolo -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/LavoratoreSubordinatoAgricolo"/>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/PrestazioneDiSostegnoAlReddito -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/PrestazioneDiSostegnoAlReddito"/>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoDomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoDomandaCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoContro"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:disjointWith>
        <rdfs:comment>Rappresenta l&apos;esito positivo totale della valutazione effettuata dalla Commissione Provinciale, la quale riconosce la validità della causa di sospensione per l&apos;intero periodo richiesto dall&apos;azienda. Tecnicamente identificato con il codice &quot;A&quot;, questo esito funge da autorizzazione legale che permette alla domanda di passare allo stato &quot;Definita&quot; e abilita la successiva fase di istruttoria per il pagamento dei lavoratori.</rdfs:comment>
        <rdfs:label xml:lang="it">Accoglimento domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoParzialeDomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoParzialeDomandaCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
        <rdfs:comment>Indica una decisione della Commissione Provinciale che approva solo una parte delle giornate di sospensione indicate nella domanda. Questo esito, codificato come &quot;P&quot;, comporta spesso la suddivisione del periodo richiesto in più segmenti (periodi parziali) con esiti differenti, consentendo comunque l&apos;erogazione della prestazione per le giornate effettivamente autorizzate.</rdfs:comment>
        <rdfs:label xml:lang="it">Accoglimento parziale domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AcquisizioneRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AcquisizioneRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FaseContenziosoCISOA"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haOutputFascicolo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/responsabileAcquisizioneRicorso"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAcquisizioneRicorso"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta la fase iniziale del contenzioso in cui il ricorso CISOA viene acquisito formalmente dalla Sede INPS territoriale tramite la procedura D.I.C.A., ai fini dell’avvio dell’istruttoria regionale.</rdfs:comment>
        <rdfs:label xml:lang="it">Acquisizione ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AutorizzazioneAziendaleDomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AutorizzazioneAziendaleDomandaCISOA">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProvvedimentoAutorizzativoCISOA"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Identifica la prima macro-fase del processo CISOA, finalizzata a verificare la sussistenza dei requisiti oggettivi in capo al datore di lavoro che presenta l&apos;istanza. Durante questa fase, la commissione provinciale o la direzione INPS accertano la regolarità dell&apos;inquadramento aziendale, l&apos;ubicazione del fondo o cantiere, la congruità della causale indicata e del periodo di sospensione richiesto. L&apos;esito positivo di questa fase è il presupposto necessario per procedere alla successiva valutazione dei singoli lavoratori beneficiari.</rdfs:comment>
        <rdfs:label xml:lang="it">Autorizzazione aziendale domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/socialSafetyNet/DatoreDiLavoroAgricolo"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/aziendaAgricolaSituataIn"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haTipoAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoEmailAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Soggetto destinatario della normativa CISOA che esercita attività agricola diretta come coltivazione del fondo, silvicoltura, allevamento di animali o trasformazione e alienazione di prodotti agricoli. La normativa include anche imprese appaltatrici o concessionarie di lavori di forestazione e consorzi di bonifica o irrigazione ed altre.</rdfs:comment>
        <rdfs:label xml:lang="it">Azienda agricola</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/BeneficiarioCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/BeneficiarioCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/socialSafetyNet/BeneficiarioPrestazioneDiSostegnoAlReddito"/>
        <rdfs:comment>Operaio agricolo con contratto a tempo indeterminato (OTI), impiegato (compresi gli apprendisti di tutte le tipologie contrattuali) o quadro che, sospeso temporaneamente dal lavoro per cause non imputabili allo stesso o al datore di lavoro, ha diritto all&apos;indennità sostitutiva della retribuzione. Per accedere alla prestazione, il lavoratore deve vantare almeno 181 giornate di effettivo lavoro annuo presso la stessa azienda, requisito che può essere derogato  in casi eccezionali, normativamente previsti.</rdfs:comment>
        <rdfs:label xml:lang="it">Beneficiario CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/aziendaAgricolaSuddivisaInCantiereOFondo"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/altitudineCantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneComuneCantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoCantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDipendentiCantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/provinciaCantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta il luogo fisico specifico (fondo agricolo, bosco, stalla o stabilimento di trasformazione) dove viene esercitata l&apos;attività e dove si verifica la sospensione lavorativa. Ogni azienda può avere più unità lavorative, ciascuna identificata da un progressivo e caratterizzata da dati geografici propri (comune, altitudine) e da un numero specifico di dipendenti in forza.</rdfs:comment>
        <rdfs:label xml:lang="it">Cantiere o Fondo</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CausaleCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CausaleCISOA">
        <rdfs:comment>Identifica la motivazione oggettiva che ha determinato l&apos;interruzione dell&apos;attività lavorativa, classificata dal sistema INPS tramite codici specifici. Le causali includono intemperie stagionali (cod. 01), ristrutturazione aziendale (cod. 05), stasi stagionale (cod. 02) o mancanza di materie prime (cod. 04). A seconda della causale, può essere previsto l&apos;utilizzo di massimali economici o specifiche deroghe normative.</rdfs:comment>
        <rdfs:label xml:lang="it">Causale CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ComitatoAmministratorePrestazioniTemporaneeAiLavoratoriDipendenti -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ComitatoAmministratorePrestazioniTemporaneeAiLavoratoriDipendenti">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/core/RuoloDiAgente"/>
        <rdfs:comment>Organo collegiale dell’INPS incaricato della gestione e della decisione sui ricorsi in materia di cassa integrazioni guadagni edilizia, industria e agricoltura.</rdfs:comment>
        <rdfs:label xml:lang="it">Comitato amministratore della gestione delle prestazioni temporanee ai lavoratori dipendenti</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CommissioneProvinciale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/core/RuoloDiAgente"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/compostaDa"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Organo collegiale operante presso ogni sede INPS, composto da  membri di diritto (tipicamente funzionari INPS , come il Direttore di sede) e rappresentanti dei datori di lavoro e dei lavoratori designati dalle rispettive organizzazioni sindacali di categori più rappresentative operanti nella provincia. Ha la competenza decisionale esclusiva sulle domande CISOA, valutando se la sospensione sia giustificata dalla causale addotta. Le sue decisioni vengono formalizzate attraverso una Delibera e un Verbale di seduta, che costituiscono il fondamento giuridico per l&apos;autorizzazione o il rigetto del trattamento di integrazione salariale.</rdfs:comment>
        <rdfs:label xml:lang="it">Commissione provinciale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloDiCompatibilitaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloDiCompatibilitaCISOA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoCompatibilita"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta un processo di verifica automatica e asincrona che il sistema INPS esegue interrogando diverse banche dati per rilevare anomalie o incompatibilità riguardanti i beneficiari inseriti in una domanda. Questi controlli analizzano segnali critici come la titolarità di pensioni, la validazione del codice fiscale su ARCA, lo stato di decesso del lavoratore o la presenza di altre domande sovrapposte nel medesimo periodo. L&apos;esito del controllo può essere &quot;OK&quot; (nessuna anomalia), &quot;KO&quot; (anomalie bloccanti) o &quot;WARNING&quot; (segnalazioni di attenzione) e la sua disponibilità è un vincolo tecnico imprescindibile per permettere all&apos;operatore di attivare la fase di istruttoria.</rdfs:comment>
        <rdfs:label xml:lang="it">Controllo di compatibilita CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DecisioneComitatoRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DecisioneComitatoRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FaseContenziosoCISOA"/>
        <rdfs:comment>Costituisce l&apos;atto finale e decisorio del procedimento amministrativo di impugnazione. La competenza spetta al Comitato Amministratore della Gestione delle Prestazioni Temporanee, che deve assumere una decisione definitiva tramite delibera entro il termine di 90 giorni dalla ricezione del ricorso.</rdfs:comment>
        <rdfs:label xml:lang="it">Decisione comitato ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DeliberaRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DeliberaRicorsoCISOA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoRicorsoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoRicorso"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Identifica la decisione finale assunta dal Comitato Amministratore in merito a un ricorso. L&apos;esito determina se la richiesta di integrazione salariale debba essere accolta (totalmente o parzialmente) a seguito del riesame, oppure se debba essere confermata la decisione originaria della Commissione Provinciale. Tale esito cristallizza la posizione amministrativa dell&apos;Istituto, avverso la quale è ammesso unicamente il ricorso al giudice ordinario.</rdfs:comment>
        <rdfs:label xml:lang="it">Delibera ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DerogaProcedurale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DerogaProcedurale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/GestionePraticaCISOA"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/prevedeProvvedimentoDirettore"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta un iter amministrativo eccezionale che modifica il percorso decisionale ordinario previsto dalla Legge 457/1972. In questo regime, la fase di valutazione non viene svolta dalla Commissione Provinciale, ma la domanda viene esaminata e autorizzata direttamente dalla direzione. Tale deroga si applica specificamente alle causali introdotte da normative d&apos;urgenza, come nel caso delle intemperie stagionali previste dal D.L. 92/2025 per i periodi tra il 1° luglio e il 31 dicembre 2025.</rdfs:comment>
        <rdfs:label xml:lang="it">Deroga procedurale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirettoreDiSedeINPS -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirettoreDiSedeINPS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/core/RuoloDiAgente"/>
        <rdfs:comment>Figura dirigenziale responsabile della direzione e del coordinamento operativo di una sede territoriale INPS, con competenza sui procedimenti e sui servizi attribuiti alla sede.</rdfs:comment>
        <rdfs:label xml:lang="it">Direttore di sede INPS</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirezioneRegionaleINPS -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DirezioneRegionaleINPS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/core/RuoloDiAgente"/>
        <rdfs:comment>Struttura organizzativa territoriale dell’INPS che svolge funzioni di governo delle risorse assegnate, assicura la gestione complessiva dei processi istituzionali e di supporto, e verifica i livelli di qualità dei servizi e dei processi nelle strutture del territorio.</rdfs:comment>
        <rdfs:label xml:lang="it">Direzione regionale INPS</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentazioneIstruttoriaRicorso -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentazioneIstruttoriaRicorso">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PropostaDeliberaRicorsoCISOA"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RelazioneIstruttoriaRicorsoCISOA"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l&apos;insieme organico degli atti e delle prove documentali gestiti dalla Direzione Regionale durante la fase di esame del merito del ricorso.</rdfs:comment>
        <rdfs:label xml:lang="it">Documentazione Istruttoria Ricorso</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentoAllegatoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentoAllegatoCISOA">
        <rdfs:comment>Identifica ogni file digitale, tipicamente in formato PDF, che l&apos;azienda trasmette a corredo della domanda telematica tramite il portale web. Gli allegati sono parte integrante del fascicolo elettronico e restano consultabili dagli operatori di sede durante le fasi di acquisizione, istruttoria e consultazione della pratica.</rdfs:comment>
        <rdfs:label xml:lang="it">Documento allegato CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/l0/Object"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADaDefinire"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADefinita"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInCommissione"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInDeroga"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInTrasmissione"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAPresentata"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/domandaCISOAPresentataDa"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/domandaCisoaRiferitaACantiereOFondo"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haModalitaPagamentoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA"/>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/VariazioneModalitaPagamentoCISOA"/>
        <rdfs:comment>È l&apos;istanza amministrativa fondamentale presentata telematicamente dalle aziende agricole per richiedere l&apos;integrazione salariale speciale per i propri dipendenti sospesi temporaneamente dall&apos;attività. L&apos;entità è composta da diversi quadri informativi che raccolgono i dati del datore di lavoro, l&apos;ubicazione del cantiere, la causale dell&apos;evento atmosferico o aziendale e l&apos;elenco analitico dei lavoratori. Ogni domanda è identificata univocamente da un numero di protocollo e da un progressivo di sede, seguendo un ciclo di vita che va dallo stato di &quot;Presentata&quot; fino alla &quot;Trasmessa&quot; per il pagamento.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADaDefinire -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADaDefinire">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Stato tecnico che indica che la seduta della Commissione si è conclusa, ma la domanda deve ancora essere lavorata dall&apos;operatore di sede tramite l&apos;inserimento materiale dell&apos;esito (Accoglimento, Rigetto o Parziale) deliberato durante la riunione. Rappresenta un passaggio intermedio necessario prima della chiusura definitiva della commissione.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA da definire</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADefinita -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOADefinita">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Rappresenta lo stato della domanda una volta che la Commissione Provinciale è stata chiusa definitivamente con l&apos;inserimento di tutti gli esiti. Per le domande con esito positivo (totale o parziale), questo stato costituisce il &quot;via libera&quot; per procedere alla successiva istruttoria tecnica sui requisiti individuali dei singoli lavoratori beneficiari.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA definita</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInCommissione -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInCommissione">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Identifica la fase in cui la domanda è stata inserita formalmente nell&apos;Ordine del Giorno (ODG) di una seduta della Commissione Provinciale. In questo stato, la pratica è in attesa di essere esaminata dall&apos;organo collegiale per la valutazione della validità della causale addotta.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA in commissione</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInDeroga -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInDeroga">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Rappresenta una specializzazione della richiesta di autorizzazione alla prestazione CISOA che segue un iter amministrativo e normativo eccezionale rispetto alla disciplina ordinaria della Legge 457/1972. A differenza delle domande standard, la cui competenza decisionale spetta alla Commissione Provinciale (organo collegiale), le domande in deroga per queste causali (come le intemperie stagionali previste dal D.L. 92/2025) vengono autorizzate direttamente dall’INPS. L&apos;atto finale non è una delibera di commissione ma un provvedimento emanato dal Direttore della Struttura territorialmente competente.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA in deroga</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInTrasmissione -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAInTrasmissione">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Indica che la fase di istruttoria individuale è terminata con successo e i dati della domanda sono stati validati e resi disponibili per l&apos;invio ai database centrali dell&apos;Istituto. Le domande in questo stato sono in attesa dell&apos;elaborazione batch quotidiana che alimenta i sistemi contabili per la liquidazione della prestazione.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA in trasmissione</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAPresentata -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOAPresentata">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>È lo stato iniziale in cui si trova la domanda subito dopo essere stata acquisita dagli archivi di sede. Indica che il file inviato dall&apos;azienda è stato preso in carico dal sistema informativo della sede INPS territorialmente competente per l&apos;avvio dell&apos;iter di verifica.</rdfs:comment>
        <rdfs:label xml:lang="it">Domanda CISOA presentata</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AutorizzazioneAziendaleDomandaCISOA"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoDomandaCISOA"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoParzialeDomandaCISOA"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ReiezioneDomandaCISOA"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProvvedimentoAutorizzativoCISOA"/>
        <rdfs:comment>Rappresenta il verdetto tecnico e giuridico emesso dalla Commissione Provinciale al termine dell&apos;esame di una domanda. Tale esito viene registrato nel sistema informativo con codici specifici: &quot;A&quot; per l&apos;accoglimento totale, &quot;P&quot; per l&apos;accoglimento parziale e &quot;R&quot; per la reiezione. La formalizzazione di un esito positivo (A o P) all&apos;interno del Verbale della Commissione costituisce l&apos;autorizzazione legale necessaria per abilitare le successive funzioni di istruttoria tecnica e procedere alla liquidazione delle somme ai lavoratori.</rdfs:comment>
        <rdfs:label xml:lang="it">Esito Commissione Provinciale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaAccolto -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaAccolto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA"/>
        <rdfs:comment>Rappresenta la conclusione positiva dell&apos;istruttoria per un determinato beneficiario. Indica che il lavoratore ha superato con successo tutti i controlli di compatibilità e possiede i requisiti legali per ricevere l&apos;indennità. Tecnicamente, questo esito abilita il calcolo dell&apos;Integrazione Salariale Lorda (ISL) e la successiva trasmissione dei dati alla piattaforma pagamenti per la liquidazione.</rdfs:comment>
        <rdfs:label xml:lang="it">Esito istruttoria accolto</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaAccolto"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaParzialmenteAccolto"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaRespinto"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoIstruttoria"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta il risultato finale della valutazione tecnica effettuata dall&apos;operatore su ogni singolo lavoratore. A differenza dell&apos;esito della Commissione (che riguarda l&apos;evento aziendale), questo esito determina se il pagamento sarà effettivamente eseguito. Viene memorizzato a sistema e può differire da quanto stabilito nel verbale della commissione qualora emergano anomalie soggettive durante i controlli tecnici.</rdfs:comment>
        <rdfs:label xml:lang="it">Esito istruttoria CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaParzialmenteAccolto -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaParzialmenteAccolto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA"/>
        <rdfs:comment>Identifica una specifica tipologia di esito derivante dalla valutazione individuale dell&apos;istruttoria. Si verifica quando:- L&apos;operatore di sede decide di non approvare l&apos;intero periodo richiesto per il lavoratore, ma solo una parte di esso, eventualmente suddividendolo in segmenti con risultati differenti.- Il numero delle giornate autorizzate viene ridotto rispetto a quelle richieste dall&apos;azienda, spesso a causa di anomalie riscontrate nei controlli di compatibilità o per il superamento dei limiti massimi fruibili.</rdfs:comment>
        <rdfs:label xml:lang="it">Esito istruttoria parzialmente accolto</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaRespinto -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaRespinto">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/abilitaARuoloDiBeneficiarioCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:disjointWith>
        <rdfs:comment>Identifica la reiezione individuale di un lavoratore all&apos;interno di una domanda che potrebbe essere stata accolta a livello aziendale. Questo esito si verifica quando i controlli di compatibilità rilevano impedimenti bloccanti (es. il lavoratore percepisce già una pensione incompatibile o è presente in altre domande sovrapposte). In questo caso, l&apos;operatore è obbligato a inserire una nota testuale di giustificazione per motivare la negazione del pagamento nel sistema informativo.</rdfs:comment>
        <rdfs:label xml:lang="it">Esito istruttoria respinto</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FascicoloRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FascicoloRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haOutputFascicolo"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Identifica l&apos;insieme organico dei documenti raccolti o generati durante la fase di acquisizione curata dalla Sede territoriale tramite la procedura D.I.C.A.. Esso comprende l&apos;atto di ricorso presentato dal soggetto legittimato (azienda, lavoratore o membro dissenziente), il provvedimento impugnato e tutta la documentazione allegata, costituendo l&apos;unità documentale che viene inoltrata alla Direzione Regionale per l&apos;esame di merito.</rdfs:comment>
        <rdfs:label xml:lang="it">Fascicolo ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FaseContenziosoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FaseContenziosoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:comment>Rappresenta il macro-processo dell&apos;iter amministrativo del contenzioso che si attiva a seguito della deliberazione della Commissione provinciale relativa a una domanda CISOA. Questa classe organizza logicamente le attività di riesame dell&apos;istanza, coordinando i passaggi procedurali e documentali che coinvolgono la Sede territoriale, la Direzione regionale e il Comitato Amministratore per giungere a una decisione definitiva in via amministrativa.</rdfs:comment>
        <rdfs:label xml:lang="it">Fase Contenzioso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/GestionePraticaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/GestionePraticaCISOA">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DerogaProcedurale"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneCommissioneProvinciale"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Organizza il dominio in base alle diverse modalità di gestione della pratica previste dalla normativa e dalla prassi operativa, suddividendosi in due percorsi distinti:1. Valutazione commissione provinciale: identifica l&apos;iter ordinario previsto dalla Legge 457/1972. In questo caso, la competenza decisionale spetta alla Commissione Provinciale, un organo collegiale che si riunisce per deliberare l&apos;esito della domanda (accoglimento, rigetto o accoglimento parziale) sulla base degli ordini del giorno preparati dagli uffici.2. Deroga procedurale: rappresenta il percorso amministrativo eccezionale introdotto per far fronte a specifiche emergenze (come stabilito dal D.L. 92/2025 per le intemperie stagionali). In questo regime, le domande sono autorizzate direttamente dall’INPS tramite un provvedimento monocratico a cura del Direttore della Struttura territorialmente competente, bypassando il passaggio collegiale in Commissione per accelerare i tempi di sostegno al reddito.</rdfs:comment>
        <rdfs:label xml:lang="it">Gestione pratica CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaConguaglioCISOA"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaPagamentoDirettoCISOA"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta la fase di verifica tecnico-amministrativa individuale condotta dall&apos;Operatore di Sede dell&apos;INPS dopo che la Commissione Provinciale ha deliberato un esito positivo sulla domanda aziendale. In questa fase, l&apos;operatore analizza la posizione di ogni singolo lavoratore per confermare il diritto alla prestazione, consultando i Controlli di Compatibilità asincroni (es. verifica pensioni o decesso) e validando i requisiti soggettivi. L&apos;istruttoria può portare a un esito di accoglimento (totale o parziale) o a una reiezione individuale, potendo anche variare in diminuzione le giornate autorizzate rispetto alla delibera collegiale.</rdfs:comment>
        <rdfs:label xml:lang="it">Istruttoria CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaConguaglioCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaConguaglioCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaPagamentoDirettoCISOA"/>
        <rdfs:comment>Rappresenta una specializzazione dell&apos;istruttoria applicata alle domande per le quali l&apos;azienda ha scelto il pagamento a conguaglio. In questa modalità, ordinaria per i lavoratori con la qualifica di operai, il datore di lavoro anticipa l&apos;integrazione salariale ai lavoratori e successivamente recupera gli importi compensandoli con i contributi dovuti all&apos;INPS. L&apos;operatore, attraverso le funzioni di &quot;Istruttoria Conguaglio&quot;, autorizza formalmente l&apos;azienda a procedere con tale operazione dopo aver validato le posizioni individuali dei beneficiari.</rdfs:comment>
        <rdfs:label xml:lang="it">Istruttoria conguaglio CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaPagamentoDirettoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaPagamentoDirettoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <rdfs:comment>Identifica la fase istruttoria per le domande in cui l&apos;INPS eroga la prestazione direttamente sul conto corrente del lavoratore. Questa modalità è obbligatoria per impiegati e quadri, o attivata per aziende in crisi di liquidità o cessazione di attività. Oltre ai controlli standard, questa fase richiede la verifica della destinazione del pagamento (codice IBAN) e l&apos;accertamento della titolarità del conto, che può sospendere la pratica fino a tre giorni per i controlli interbancari.</rdfs:comment>
        <rdfs:label xml:lang="it">Istruttoria pagamento diretto CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/FaseContenziosoCISOA"/>
        <rdfs:comment>Rappresenta la fase di esame e preparazione della decisione, condotta dalla Direzione Regionale competente. In questa fase, l&apos;ufficio regionale esamina nel merito le motivazioni del ricorso e la documentazione allegata, con l&apos;obiettivo di produrre due documenti essenziali per il decidere: la relazione istruttoria e la proposta di delibera. Una volta completata questa analisi, la Direzione Regionale provvede a inoltrare l&apos;intero fascicolo al Comitato Amministratore, per il tramite della Direzione centrale ,  per la risoluzione del caso.</rdfs:comment>
        <rdfs:label xml:lang="it">Istruttoria ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/RO/Role"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoDa"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaFineLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaInizioLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataFineSospensioneLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioContrattoLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioSospensioneLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneMansione"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagLavoratoreMensilizzato"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPensionatoLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:length rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</xsd:length>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniAssenzaLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniIntegrazioneSalarialeRichiestaLavoratoreInteressatoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l&apos;operaio agricolo a cui si riferisce la domanda CISOA presentata dall’azienda, distinto dal beneficiario CISOA che ha già ottenuto il riconoscimento della prestazione.</rdfs:comment>
        <rdfs:label xml:lang="it">Lavoratore Interessato CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MassimaleCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MassimaleCISOA">
        <rdfs:comment>Rappresenta il limite massimo mensile di integrazione salariale erogabile per determinati trattamenti. La sua applicazione dipende dalla causale e dalla normativa vigente al momento della sospensione.</rdfs:comment>
        <rdfs:label xml:lang="it">Massimale CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/compostaDa"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoDa"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Identifica i singoli componenti dell&apos;organo deliberante, che includono membri di diritto (tipicamente funzionari INPS , come il Direttore di sede) e rappresentanti dei datori di lavoro e dei lavoratori designati dalle rispettive organizzazioni sindacali di categoria più rappresentative operanti nella provincia. Ogni sede gestisce una &quot;Commissione STANDARD&quot;, i cui membri sono stabiliti da un apposito decreto di nomina. All&apos;interno di una specifica seduta, il sistema distingue tra i membri teorici e i &quot;Partecipanti&quot; effettivamente presenti, la cui conferma è necessaria per la validità legale del verbale e per la generazione della documentazione per la Ragioneria.</rdfs:comment>
        <rdfs:label xml:lang="it">Membro commissione provinciale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/OperatoreDiSedeINPS -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/OperatoreDiSedeINPS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/matricolaOperatoreDiSede"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Figura professionale interna all&apos;Istituto incaricata della lavorazione delle domande di competenza della propria sede territoriale. L&apos;operatore svolge compiti decisivi quali la selezione manuale delle pratiche da sottoporre alla Commissione, la conduzione dell&apos;istruttoria tecnica individuale su ogni beneficiario e la validazione finale dei dati per il pagamento. Ha inoltre la responsabilità di inserire a sistema gli esiti della delibera e di trasmettere i flussi contabili alla piattaforma pagamenti.</rdfs:comment>
        <rdfs:label xml:lang="it">Operatore di sede INPS</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoAConguaglio -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoAConguaglio">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA"/>
        <owl:disjointWith rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoDirettoINPS"/>
        <rdfs:comment>Rappresenta la modalità di erogazione in cui il datore di lavoro anticipa materialmente l&apos;integrazione salariale ai lavoratori e successivamente recupera tali somme compensandole con i contributi previdenziali dovuti all&apos;INPS. Questa modalità è tipica delle aziende di maggiori dimensioni ed è diventata obbligatoria per molti Contratti Collettivi Nazionali (CCNL) del settore agricolo a partire dal 2007. Il recupero degli importi deve essere effettuato dall&apos;azienda, a pena di decadenza, entro 6 mesi dalla fine del periodo di paga o dalla data del provvedimento di concessione.</rdfs:comment>
        <rdfs:label xml:lang="it">Pagamento A conguaglio</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoDirettoINPS -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoDirettoINPS">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/socialSafetyNet/IBAN"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta la modalità di erogazione in cui il datore di lavoro anticipa materialmente l&apos;integrazione salariale ai lavoratori e successivamente recupera tali somme compensandole con i contributi previdenziali dovuti all&apos;INPS. Questa modalità è diventata obbligatoria per i Contratti Collettivi Nazionali (CCNL) del settore agricolo (operai agricoli e florovivaisti e per gli addetti alla sistenazone idraulico-forestale e idarulico-agraria) a partire dal  1° ottobre 2007. Il  conguaglio o la richiesta di rimborso deve essere effettuato dall&apos;azienda, a pena di decadenza, entro 6 mesi dalla fine del periodo di paga in corso alla scadenza del termine di durata della concessione o dalla data del provvedimento di concessione, se successiva.</rdfs:comment>
        <rdfs:label xml:lang="it">Pagamento diretto INPS</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PeriodoSospensione -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PeriodoSospensione">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haCausaleCISOASpecificata"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l&apos;intervallo temporale, definito da una data di inizio e una data di fine, durante il quale l&apos;attività lavorativa viene interrotta o ridotta per cause non imputabili al datore di lavoro o al dipendente. Il periodo è un elemento essenziale della domanda e deve essere riconducibile a una delle causali ammesse. Sulla base di questo arco temporale, il sistema calcola le giornate effettivamente integrabili, escludendo domeniche e festività nazionali.</rdfs:comment>
        <rdfs:label xml:lang="it">Periodo sospensione</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PrestazioneCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PrestazioneCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/socialSafetyNet/PrestazioneDiSostegnoAlReddito"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Consiste nell&apos;indennità sostitutiva della retribuzione erogata dall&apos;INPS per tutelare il reddito dei lavoratori agricoli in caso di intemperie stagionali o altre cause non imputabili agli stessi o al datore di lavoro. Istituita dalla Legge 8 agosto 1972, n. 457, la prestazione spetta principalmente agli operai agricoli a tempo indeterminato (OTI), impiegati, quadri e apprendisti che possiedono i requisiti occupazionali previsti (almeno 181 giornate di lavoro annue presso la stessa azienda), fungendo da ammortizzatore sociale specifico per il settore primario.</rdfs:comment>
        <rdfs:label xml:lang="it">Prestazione CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProceduraD.I.C.A. -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProceduraD.I.C.A.">
        <rdfs:comment>Rappresenta lo strumento informatico e amministrativo, il cui acronimo significa Decentramento Istruttoria Contenzioso Amministrativo, utilizzato dalla Sede territoriale INPS per l’acquisizione formale dei ricorsi proposti avverso la deliberazione della Commissione provinciale relativa a una domanda CISOA. Esso funge da supporto tecnico per la presa in carico dell’istanza di impugnazione, garantendo il corretto instradamento della pratica verso la successiva fase di istruttoria regionale.</rdfs:comment>
        <rdfs:label xml:lang="it">Procedura D.I.C.A.</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PropostaDeliberaRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PropostaDeliberaRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentazioneIstruttoriaRicorso"/>
        <rdfs:comment>Costituisce l&apos;atto formale conclusivo dell&apos;istruttoria regionale con cui viene formulato un suggerimento specifico sull&apos;esito da attribuire al contenzioso. Tale proposta viene trasmessa, unitamente alla relazione istruttoria, al Comitato Amministratore della Gestione delle Prestazioni Temporanee, che è il soggetto competente per l&apos;emanazione della deliberazione definitiva.</rdfs:comment>
        <rdfs:label xml:lang="it">Proposta delibera ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProvvedimentoAutorizzativoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ProvvedimentoAutorizzativoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AutorizzazioneAziendaleDomandaCISOA"/>
        <rdfs:comment>ll Provvedimento autorizzativo CISOA emanato dal Direttore di sede INPS rappresenta un atto amministrativo monocratico di autorizzazione che interviene in deroga all&apos;iter ordinario di competenza della Commissione Provinciale. Questo provvedimento si configura come il risultato di una &quot;Deroga procedurale&quot; che bypassa la Commissione Provinciale per specifiche motivazioni normative, mantenendo però la stessa finalità di sblocco della pratica per l&apos;erogazione della prestazione.</rdfs:comment>
        <rdfs:label xml:lang="it">Provvedimento autorizzativo CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ReiezioneDomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ReiezioneDomandaCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
        <owl:disjointWith>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/autorizzazioneAziendalePositivaAttivaIstruttoria"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:disjointWith>
        <rdfs:comment>Rappresenta l&apos;esito negativo (diniego) deliberato dalla Commissione Provinciale, identificato tecnicamente con il codice &quot;R&quot;. Si verifica quando l&apos;organo collegiale accerta che non sussistono i presupposti legali o che le causali dichiarate (es. intemperie) non sono state tali da impedire l&apos;attività lavorativa. La reiezione comporta l&apos;invio di una comunicazione formale all&apos;azienda.</rdfs:comment>
        <rdfs:label xml:lang="it">Reiezione domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RelazioneIstruttoriaRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RelazioneIstruttoriaRicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentazioneIstruttoriaRicorso"/>
        <rdfs:comment>Identifica il documento di analisi tecnico-giuridica predisposto dalla Direzione Regionale a seguito dell&apos;esame del ricorso e dei suoi allegati. Questo atto contiene una ricostruzione puntuale dei fatti e una valutazione di merito sull&apos;istanza, fungendo da supporto conoscitivo e motivazionale necessario affinché l&apos;organo collegiale possa assumere la decisione finale.</rdfs:comment>
        <rdfs:label xml:lang="it">Relazione istruttoria ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/l0/Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDICARicorsoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoRicorsoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l’atto di opposizione amministrativa avverso la deliberazione di reiezione o di accoglimento parziale di una domanda emanata dalla Commissione Provinciale. Il ricorso può essere presentato dall’azienda, dai singoli lavoratori o dai membri della Commissione che abbiano espresso e verbalizzato il proprio dissenso durante la votazione. La presentazione deve avvenire entro 30 giorni dalla ricezione del provvedimento; la decisione definitiva spetta al Comitato Amministratore della Gestione delle Prestazioni Temporanee ai Lavoratori Dipendenti.</rdfs:comment>
        <rdfs:label xml:lang="it">Ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SedutaCommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SedutaCommissioneProvinciale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceSedutaCommissioneProvinciale"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDelibera"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneSedutaCommissioneProvinciale"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l&apos;evento temporale specifico (riunione) in cui l&apos;organo collegiale della Sede INPS si incontra per esaminare e deliberare sulle domande CISOA acquisite. Durante la preparazione di una seduta, l&apos;operatore stabilisce la data della riunione, definisce l&apos;Ordine del Giorno (ODG) con l&apos;elenco delle pratiche da esaminare e identifica i componenti partecipanti. Una seduta può assumere forma ordinaria o speciale (ad esempio per eventi climatici eccezionali) e si conclude formalmente con la &quot;chiusura della commissione&quot; dopo l&apos;inserimento di tutti gli esiti, rendendo i dati immodificabili e consultabili negli archivi storici.</rdfs:comment>
        <rdfs:label xml:lang="it">Seduta Commissione provinciale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/StatoAcquisizioneDomandaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/StatoAcquisizioneDomandaCISOA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceStatoAcquisizioneDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneStatoAcquisizioneDomandaCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Lo stato di acquisizione definisce la condizione amministrativa di una pratica telematica. Questa classificazione permette al sistema di gestire le fasi operative e di applicare i necessari controlli di validazione prima che la domanda diventi lavorabile dalla sede INPS competente.</rdfs:comment>
        <rdfs:label xml:lang="it">Stato acquisizione domanda CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAssenza -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAssenza">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAssenza"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAssenza"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta la motivazione giuridica o amministrativa per cui un lavoratore può risultare assente all&apos;inizio o alla fine del periodo di sospensione dell&apos;attività lavorativa.</rdfs:comment>
        <rdfs:label xml:lang="it">Tipo assenza</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAziendaAgricola -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAziendaAgricola">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/haTipoAziendaAgricola"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAziendaAgricola"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Definisce la classificazione giuridica e operativa dell&apos;azienda che presenta la domanda CISOA. È un componente fondamentale per determinare l&apos;inquadramento e l&apos;applicabilità della norma. I valori tecnici previsti dal sistema includono:CE: Conduzione in economia.CD: Coltivatore diretto.CM: Mezzadria o colonia.COOP: Cooperativa o consorzio agricolo.CB: Consorzio di bonifica o irrigazione.EF: Ente pubblico esercente forestazione.A: Altro.</rdfs:comment>
        <rdfs:label xml:lang="it">Tipo azienda agricola</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoCausaleCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoCausaleCISOA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoCausaleCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoCausaleCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta il raggruppamento delle motivazioni giuridico-normative che giustificano la richiesta di prestazione CISOA a seguito della sospensione o riduzione dell&apos;attività lavorativa.</rdfs:comment>
        <rdfs:label xml:lang="it">Tipo causale CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoControlloDiCompatibilità -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoControlloDiCompatibilità">
        <rdfs:comment>Definisce le diverse tipologie di verifiche automatiche che il sistema INPS esegue sulla posizione individuale di ogni lavoratore agricolo indicato in domanda.</rdfs:comment>
        <rdfs:label xml:lang="it">Tipo controllo di compatibilità</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoAConguaglio"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoDirettoINPS"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoPagamentoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoPagamentoCISOA"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta la modalità con cui viene erogata l&apos;indennità al lavoratore. Esistono due tipologie principali stabilite dalla prassi e dalla normativa:Pagamento Diretto: l&apos;INPS eroga la prestazione direttamente sul conto corrente del lavoratore (tramite IBAN) o allo sportello postale. È la modalità standard per gli impiegati e i quadri, nei casi di cessazione o di mancanza di liquidità dell&apos;azienda agricola. Pagamento a Conguaglio: l&apos;azienda anticipa l&apos;indennità al lavoratore e recupera l&apos;importo compensandolo con i contributi dovuti all&apos;Istituto. È la modalità ordinaria di pagamento nei confronti degli operai.</rdfs:comment>
        <rdfs:label xml:lang="it">Tipo pagamento CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TrattenutaSindacalePrestazioneCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TrattenutaSindacalePrestazioneCISOA">
        <rdfs:comment>Rappresenta la deduzione monetaria operata sulla prestazione CISOA a seguito di una specifica delega sottoscritta dal lavoratore in favore di un&apos;organizzazione sindacale.</rdfs:comment>
        <rdfs:label xml:lang="it">Trattenuta sindacale prestazione CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneCommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneCommissioneProvinciale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/GestionePraticaCISOA"/>
        <rdfs:comment>È l&apos;atto formale e ufficiale prodotto dalla Commissione Provinciale al termine di ogni seduta deliberativa. Il verbale &quot;cristallizza&quot; l&apos;attività dell&apos;organo collegiale, contenendo l&apos;elenco dei membri partecipanti, le annotazioni della discussione e, soprattutto, l&apos;esito definitivo (Accolta, Respinta o Parziale) per ciascuna domanda esaminata. All&apos;interno del sistema, il verbale funge da documento di controllo e base legale per l&apos;operatore di sede, che deve inserire i dati approvati prima di chiudere definitivamente la commissione e passare alla fase successiva.</rdfs:comment>
        <rdfs:label xml:lang="it">Valutazione Commissione Provinciale</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneIndividualeIstruttoriaCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneIndividualeIstruttoriaCISOA">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/effettuaValutazioneIndividuale"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Rappresenta l&apos;attività di verifica puntuale condotta dall&apos;operatore di sede INPS su ogni singolo lavoratore agricolo inserito in una domanda CISOA già autorizzata dalla Commissione Provinciale.</rdfs:comment>
        <rdfs:label xml:lang="it">Valutazione individuale istruttoria CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneRicorsoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneRicorsoCISOA">
        <rdfs:comment>Rappresenta l’attività di esame e ponderazione del ricorso amministrativo CISOA svolta dal Comitato amministratore della gestione delle prestazioni temporanee al fine di determinare l’esito finale del procedimento. La valutazione prende in considerazione il contenuto del ricorso, la documentazione istruttoria predisposta dalla Direzione regionale, la relazione istruttoria e la proposta di delibera, e conduce alla formulazione della delibera conclusiva del ricorso.</rdfs:comment>
        <rdfs:label xml:lang="it">Valutazione ricorso CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/VariazioneModalitaPagamentoCISOA -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/VariazioneModalitaPagamentoCISOA">
        <rdfs:comment>Rappresenta l&apos;entità che gestisce il cambiamento della forma di erogazione della prestazione (da conguaglio a pagamento diretto o viceversa) richiesto dopo la presentazione della domanda. Sebbene la modalità sia inizialmente scelta dall&apos;azienda nel modello SR33, la variazione può essere richiesta tramite canali extra-procedurali (come la PEC) per motivi sopravvenuti, quali crisi di liquidità o cessazione dell&apos;attività. Questa modifica viene gestita manualmente dall&apos;operatore di sede all&apos;interno dell&apos;applicativo prima o durante la fase istruttoria.</rdfs:comment>
        <rdfs:label xml:lang="it">Variazione modalita pagamento CISOA</rdfs:label>
    </owl:Class>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/VerbaleCommissioneProvinciale -->

    <owl:Class rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/VerbaleCommissioneProvinciale">
        <rdfs:comment>È l&apos;atto formale e ufficiale prodotto dalla Commissione Provinciale al termine di ogni seduta deliberativa. Il verbale &quot;cristallizza&quot; l&apos;attività dell&apos;organo collegiale, contenendo l&apos;elenco dei membri partecipanti, le annotazioni della discussione e, soprattutto, l&apos;esito definitivo (Accolta, Respinta o Parziale) per ciascuna domanda esaminata. All&apos;interno del sistema, il verbale funge da documento di controllo e base legale per l&apos;operatore di sede, che deve inserire i dati approvati prima di chiudere definitivamente la commissione e avviare i pagamenti.</rdfs:comment>
        <rdfs:label xml:lang="it">Verbale commissione provinciale</rdfs:label>
    </owl:Class>



