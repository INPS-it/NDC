            <owl:Class>
                <owl:complementOf rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AccoglimentoDomandaCISOA"/>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="it">ricorso CISOA proposto contro</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoDa -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoCISOApropostoDa">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/DatoreDiLavoroAgricolo"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
                    <rdf:Description rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="it">ricorso CISO aproposto da</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ricorsoHaFaseContenziosoCISOA -->

