    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valutazioneIndividualeRiguardaLavoratoreInteressatoCISOA -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valutazioneIndividualeRiguardaLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValutazioneIndividualeIstruttoriaCISOA"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
