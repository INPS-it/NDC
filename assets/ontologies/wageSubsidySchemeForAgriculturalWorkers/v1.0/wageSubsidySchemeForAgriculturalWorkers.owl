        <rdfs:label xml:lang="it">valuta controllo di compatibilita</rdfs:label>
    </owl:ObjectProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valutazioneEsaminaDocumentazione -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valutazioneEsaminaDocumentazione">
