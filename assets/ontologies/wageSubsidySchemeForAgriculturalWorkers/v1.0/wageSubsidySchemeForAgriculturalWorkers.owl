        <rdfs:comment>Controllo relativo alla verifica di eventuali pagamenti riferiti a prestazioni previdenziali non pensionistiche, effettuato ai fini della valutazione di compatibilità della prestazione CISOA.</rdfs:comment>
        <rdfs:label xml:lang="it">Controllo pagamenti hub PNP</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloPensione -->

    <owl:NamedIndividual rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloPensione">
        <rdf:type rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoControlloDiCompatibilità"/>
        <rdfs:comment>Controlla se il lavoratore percepisce già trattamenti pensionistici non cumulabili con l&apos;integrazione salariale.</rdfs:comment>
        <rdfs:label xml:lang="it">Controllo pensione</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloUnilav -->

    <owl:NamedIndividual rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloUnilav">
        <rdf:type rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoControlloDiCompatibilità"/>
