        <rdfs:label xml:lang="it">Controllo Unilav</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SogliaRetribuzioneGiornaliera -->

