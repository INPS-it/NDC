    </owl:ObjectProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->




    <!-- https://w3id.org/italia/social-security/onto/core/codiceSedeINPS -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/core/codiceSedeINPS">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/core/SedeINPS"/>
        <rdfs:label xml:lang="it">codice sede INPS</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/socialSafetyNet/IBAN -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/socialSafetyNet/IBAN">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PagamentoDirettoINPS"/>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/altitudineCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/altitudineCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>Identifica l&apos;altezza sopra il livello del mare del luogo fisico (cantiere o fondo) dove operano i lavoratori beneficiari. Si tratta di un&apos;informazione di rilievo tecnico per la valutazione della domanda, in quanto può fornire alla Commissione Provinciale elementi di contesto necessari per accertare la veridicità di causali legate ad avversità atmosferiche (come gelo o neve) in relazione alla specifica collocazione geografica del sito lavorativo.</rdfs:comment>
        <rdfs:label xml:lang="it">altitudine del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDICARicorsoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDICARicorsoCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA"/>
        <rdfs:comment>Rappresenta l&apos;identificativo amministrativo univoco assegnato dal sistema informatico dell&apos;Istituto nel momento in cui l&apos;atto di impugnazione viene acquisito.</rdfs:comment>
        <rdfs:label xml:lang="it">codice DICA ricorso CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Identifica univocamente la pratica amministrativa all&apos;interno del sistema informativo INPS. </rdfs:comment>
        <rdfs:label xml:lang="it">codice domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoCompatibilita -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoCompatibilita">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloDiCompatibilitaCISOA"/>
        <rdfs:comment>Rappresenta il codice numerico che sintetizza il risultato delle verifiche automatiche effettuate dal sistema interrogando basi dati esterne.</rdfs:comment>
        <rdfs:label xml:lang="it">codice esito compatibilita</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta il valore codificato della decisione assunta dalla Commissione Provinciale in merito all&apos;istanza aziendale. Questa proprietà può assumere i seguenti valori standard previsti dalla procedura:&quot;A&quot;: Accolta (approvazione totale della richiesta).&quot;P&quot;: Parzialmente accolta (approvazione di solo una parte del periodo o delle giornate).&quot;R&quot;: Respinta (reiezione della domanda per mancanza di requisiti o causali non idonee).</rdfs:comment>
        <rdfs:label xml:lang="it">codice esito domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoIstruttoria -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoIstruttoria">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA"/>
        <rdfs:comment>Rappresenta il valore alfanumerico che identifica la decisione tecnica presa dall&apos;Operatore di Sede per ogni singolo periodo richiesto dal lavoratore. I valori tipici sono:&quot;A&quot;: Accolto (il pagamento per quel periodo è validato).&quot;R&quot;: Respinto (il pagamento è negato a seguito dei controlli di compatibilità o mancanza di requisiti individuali). A differenza dell&apos;esito della Commissione, questo codice determina l&apos;effettiva liquidazione della prestazione al beneficiario.</rdfs:comment>
        <rdfs:label xml:lang="en">codice esito istruttoria</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoRicorsoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceEsitoRicorsoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DeliberaRicorsoCISOA"/>
        <rdfs:comment>Codifica le possibili risultanze del giudizio del Comitato attraverso i seguenti valori standard:C: Domanda accolta su ricorso.D: Domanda parzialmente accolta su ricorso.T: Domanda respinta su ricorso.U: L’esito della domanda resta confermato anche in seguito al ricorso.V: Domanda parzialmente respinta in seguito a ricorso.</rdfs:comment>
        <rdfs:label xml:lang="it">codice esito ricorso CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleAziendaAgricola -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleAziendaAgricola">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola"/>
        <rdfs:comment>Identifica il codice fiscale dell&apos;azienda agricola.</rdfs:comment>
        <rdfs:label xml:lang="it">codice fiscale azienda agricola</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceFiscaleLavoratoreInteressatoCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Indica il codice alfanumerico univoco di 16 caratteri che identifica il lavoratore nei sistemi dell&apos;Istituto.</rdfs:comment>
        <rdfs:label xml:lang="it">codice fiscale lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceIdentificativoDenunciaAziendaleCIDA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceIdentificativoDenunciaAziendaleCIDA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola"/>
        <rdfs:comment>Il CIDA (Codice Identificativo Denuncia Aziendale) è un codice numerico univoco dell’azienda agricola, rilasciato dall&apos;INPS, utilizzato per gli adempimenti previdenziali relativi alla manodopera agricola.</rdfs:comment>
        <rdfs:label xml:lang="it">codice identificativo denuncia aziendale CIDA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceSedeMembroCommissione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceSedeMembroCommissione">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale"/>
        <rdfs:comment>Identifica in modo univoco l&apos;ufficio territoriale INPS presso il quale opera un componente della Commissione CISOA.</rdfs:comment>
        <rdfs:label xml:lang="it">codice sede membro commissione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceSedutaCommissioneProvinciale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceSedutaCommissioneProvinciale">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SedutaCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta l&apos;identificativo progressivo univoco assegnato a una specifica seduta della Commissione Provinciale presso una determinata sede INPS. </rdfs:comment>
        <rdfs:label>codice seduta Commissione Provinciale</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceStatisticoContributivoCSC -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceStatisticoContributivoCSC">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola"/>
        <rdfs:comment>Il CSC (Codice Statistico Contributivo) è un codice numerico attribuito dall’INPS ai datori di lavoro per classificare l’azienda in base all’attività economica svolta e determinare il corretto inquadramento e le aliquote contributive applicabili; il CSC è inoltre usato per finalità statistiche e può essere associato ai codici di autorizzazione e al codice ATECO.</rdfs:comment>
        <rdfs:label xml:lang="it">codice statistico contributivo CSC</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceStatoAcquisizioneDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceStatoAcquisizioneDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/StatoAcquisizioneDomandaCISOA"/>
        <rdfs:comment>Indica il valore alfanumerico. I codici principali sono:N: Nuova domanda (fase di bozza).P: Domanda presentata ad INPS.B: Trasmessa alla sede di presa in carico.C: Cancellata logicamente.</rdfs:comment>
        <rdfs:label xml:lang="it">codice stato acquisizione domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAssenza -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAssenza">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAssenza"/>
        <rdfs:comment>Identifica l&apos;assenza tramite un codice mnemonico a un carattere. Gli esempi includono: &apos;M&apos; (malattia), &apos;F&apos; (ferie), &apos;P&apos; (permessi), &apos;MAT&apos; (gravidanza e puerperio).</rdfs:comment>
        <rdfs:label xml:lang="it">codice tipo assenza</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAziendaAgricola -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoAziendaAgricola">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAziendaAgricola"/>
        <rdfs:comment>Mappa la classificazione operativa del datore di lavoro, necessaria per determinare l&apos;inquadramento contributivo corretto.</rdfs:comment>
        <rdfs:label xml:lang="it">codice tipo azienda agricola</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoCausaleCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoCausaleCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoCausaleCISOA"/>
        <rdfs:comment>E&apos; il codice alfanumerico univoco (tipicamente di 2 caratteri) che identifica una specifica causale di sospensione all&apos;interno del sistema.</rdfs:comment>
        <rdfs:label xml:lang="it">codice tipo causale CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoPagamentoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/codiceTipoPagamentoCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA"/>
        <rdfs:comment>È la proprietà tecnica che mappa i valori utilizzati nei database INPS per identificare la modalità di erogazione. I valori codificati sono:D: Pagamento Diretto.C: Pagamento a Conguaglio.</rdfs:comment>
        <rdfs:label xml:lang="it">codice tipo pagamento CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/contoTrattenuta -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/contoTrattenuta">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TrattenutaSindacalePrestazioneCISOA"/>
        <rdfs:comment>Identifica il conto di imputazione contabile necessario per indirizzare correttamente le somme trattenute verso la ragioneria.</rdfs:comment>
        <rdfs:label xml:lang="it">conto trattenuta</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAcquisizioneRicorso -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAcquisizioneRicorso">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AcquisizioneRicorsoCISOA"/>
        <rdfs:comment>Indica la data in cui il soggetto legittimato presenta l&apos;istanza di ricorso.</rdfs:comment>
        <rdfs:label xml:lang="it">data acquisizione ricorso CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaFineLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaFineLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Indica la data di fine dell&apos;eventuale assenza (es. termine del periodo di malattia o ferie) intervenuta a ridosso dell&apos;inizio o della fine della sospensione CISOA.</rdfs:comment>
        <rdfs:label xml:lang="it">data assenza fine lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaInizioLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataAssenzaInizioLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Rappresenta la data di inizio di un&apos;eventuale assenza del lavoratore (come malattia, infortunio o ferie) che coincide con l&apos;inizio o con la fine del periodo di sospensione dell&apos;attività lavorativa richiesto nella domanda.</rdfs:comment>
        <rdfs:label xml:lang="it">data assenza inizio lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompabilita -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompabilita">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloDiCompatibilitaCISOA"/>
        <rdfs:comment>Rappresenta la data e l&apos;ora in cui è stato aggiornato l&apos;esito dei controlli di compatibilità per i beneficiari presenti in domanda. Poiché i controlli di compatibilità (che interrogano banche dati esterne) avvengono in modalità asincrona, la registrazione di questa data attesta il completamento delle verifiche tecniche necessarie all&apos;operatore per procedere con l&apos;istruttoria.</rdfs:comment>
        <rdfs:label xml:lang="it">data compabilita</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompilazioneDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataCompilazioneDomandaCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Indica la data in cui sono stati inseriti o aggiornati i dati della domanda sul portale &quot;CISOA Web&quot; prima dell&apos;invio telematico. Corrisponde all&apos;ultimo salvataggio effettuato dall&apos;utente (azienda o consulente). È un dato fondamentale per la tracciabilità della pratica, in quanto il sistema richiede l&apos;aggiornamento di questa data a ogni modifica apportata ai singoli quadri (A, B, C, ecc.).</rdfs:comment>
        <rdfs:label xml:lang="it">data compilazione domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDefinizioneRicorsoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DeliberaRicorsoCISOA"/>
        <rdfs:comment>Rappresenta la data in cui viene emessa la deliberazione definitiva da parte del Comitato Amministratore. I termini per la decisione sono fissati in 90 giorni decorrenti dalla data di ricezione del ricorso attestata dal protocollo informatico, sebbene il Comitato conservi la potestà di decidere anche oltre tale scadenza.</rdfs:comment>
        <rdfs:label xml:lang="it">data definizione ricorso CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDelibera -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataDelibera">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SedutaCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta la data solare in cui si riunisce l&apos;organo collegiale per esaminare le domande e assumere le decisioni di accoglimento, accoglimemto parziale o rigetto. </rdfs:comment>
        <rdfs:label xml:lang="it">data delibera</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataFinePeriodoSospensione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataFinePeriodoSospensione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PeriodoSospensione"/>
        <rdfs:comment>Identifica il giorno conclusivo dell&apos;intervallo temporale in cui l&apos;attività lavorativa è stata interrotta o ridotta per la causale indicata.</rdfs:comment>
        <rdfs:label xml:lang="it">data fine sospensione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataFineSospensioneLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataFineSospensioneLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Fine del periodo in cui il lavoratore ha sospeso l’attività.</rdfs:comment>
        <rdfs:label xml:lang="it">data fine sospensione lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioContrattoLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioContrattoLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Indica la data in cui ha avuto inizio il contratto di lavoro a tempo indeterminato del lavoratore presso l&apos;azienda agricola.</rdfs:comment>
        <rdfs:label xml:lang="it">data inizio contratto lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioPeriodoSospensione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioPeriodoSospensione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PeriodoSospensione"/>
        <rdfs:comment>Indica il giorno iniziale del periodo di fermo lavorativo oggetto della richiesta di integrazione salariale.</rdfs:comment>
        <rdfs:label xml:lang="it">data inizio sospensione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioSospensioneLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataInizioSospensioneLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Inizio del periodo in cui il lavoratore ha sospeso l’attività.</rdfs:comment>
        <rdfs:label xml:lang="it">data inizio sospensione lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataPresentazioneDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataPresentazioneDomandaCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Rappresenta la data esatta in cui l&apos;azienda (o il suo intermediario) trasmette telematicamente il modello SR33 all&apos;Istituto. Questo attributo è determinante per verificare il rispetto dei termini di invio previsti dalla norma (15 giorni dall&apos;evento). Il sistema informatico utilizza questa data anche per contrassegnare lo stato della domanda come &quot;OK&quot; se presentata nei termini.</rdfs:comment>
        <rdfs:label xml:lang="it">data presentazione domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataRicezioneDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataRicezioneDomandaCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Rappresenta la data di presa in carico della domanda da parte della sede INPS territorialmente competente.</rdfs:comment>
        <rdfs:label xml:lang="it">data ricezione domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataUltimoSalvataggioIstruttoria -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/dataUltimoSalvataggioIstruttoria">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <rdfs:comment>Identifica il timestamp dell&apos;ultimo aggiornamento o consolidamento dei dati effettuato dall&apos;operatore di sede durante la fase di verifica individuale dei beneficiari. Questa proprietà traccia il momento in cui la posizione del lavoratore è stata salvata (temporaneamente o definitivamente), bloccando o rendendo disponibili i dati per la successiva trasmissione ai sistemi di pagamento centrali.</rdfs:comment>
        <rdfs:label xml:lang="it">data ultimo salvataggio istruttoria</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneComuneCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneComuneCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>Rappresenta il nome del comune in cui è ubicato il cantiere o il fondo agricolo presso cui operano i lavoratori e nel quale si è verificata la sospensione dell’attività. Si tratta di un dato geografico rilevante ai fini della valutazione dell’evento meteorologico eventualmente dichiarato.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione comune del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta l&apos;etichetta testuale che esplicita la decisione finale assunta dalla Commissione Provinciale in merito alla domanda presentata dall&apos;azienda.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione esito domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoRicorso -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneEsitoRicorso">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DeliberaRicorsoCISOA"/>
        <rdfs:comment>Rappresenta la specifica testuale della decisione finale assunta dal Comitato Amministratore della Gestione delle Prestazioni Temporanee.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione esito ricorso</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneMansione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneMansione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Indica l&apos;attività lavorativa o il ruolo professionale effettivamente svolto dal lavoratore al momento dell&apos;inizio della sospensione dell&apos;attività. Si tratta di una proprietà informativa obbligatoria da inserire nel Quadro F. Tale descrizione è necessaria per verificare se e in che modo l&apos;evento sospensivo dichiarato abbia effettivamente inciso sull&apos;attività svolta.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione mansione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneMembroCommissioneProvinciale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneMembroCommissioneProvinciale">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale"/>
        <rdfs:comment>Rappresenta l&apos;etichetta testuale o la qualifica associata a un componente dell&apos;organo deliberante e descrive il ruolo specifico ricoperto dal membro durante la seduta, come &quot;Presidente&quot;, &quot;Segretario&quot; o &quot;Rappresentante sindacale&quot;. </rdfs:comment>
        <rdfs:label xml:lang="it">descrizione membro commissione provinciale</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneSedutaCommissioneProvinciale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneSedutaCommissioneProvinciale">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/SedutaCommissioneProvinciale"/>
        <rdfs:comment>Indica il nome o la denominazione testuale assegnata a una specifica seduta dell&apos;organo collegiale. Questa proprietà permette di identificare la tipologia di riunione o il contesto in cui vengono esaminate le domande (ad esempio, &quot;Commissione Ordinaria&quot; o &quot;Commissione Straordinaria Emergenza Meteo&quot;). Serve a distinguere le diverse sessioni deliberative all&apos;interno della medesima sede INPS e a facilitare la ricerca e la consultazione dei verbali storici.</rdfs:comment>
        <rdfs:label>descrizione seduta Commissione Provinciale</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneStatoAcquisizioneDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneStatoAcquisizioneDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/StatoAcquisizioneDomandaCISOA"/>
        <rdfs:comment>È la definizione testuale che spiega il significato del codice di stato. Ad esempio, per il codice P, la descrizione è &quot;la domanda è presentata ad INPS&quot;; per il codice B, è &quot;la domanda è trasmessa alla sede di presa in carico con i beneficiari&quot;.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione stato acquisizione domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAssenza -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAssenza">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAssenza"/>
        <rdfs:comment>Identifica l&apos; attributo testuale che riporta la denominazione estesa del tipo di assenza. Ad esempio: &quot;ASSENZA VOLONTARIA&quot;, &quot;INFORTUNIO&quot; o &quot;SCIOPERO&quot;.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione tipo assenza</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAziendaAgricola -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoAziendaAgricola">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoAziendaAgricola"/>
        <rdfs:comment>Rappresenta l&apos;etichetta testuale estesa che identifica l&apos;inquadramento giuridico e operativo del datore di lavoro.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione tipo azienda agricola</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoCausaleCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoCausaleCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoCausaleCISOA"/>
        <rdfs:comment>Consiste nell&apos;etichetta testuale estesa che illustra la motivazione della richiesta di integrazione salariale associata al relativo codice.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione tipo causale CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoPagamentoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/descrizioneTipoPagamentoCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TipoPagamentoCISOA"/>
        <rdfs:comment>Rappresenta l&apos;etichetta testuale associata al codice di pagamento, utilizzata nelle interfacce utente e nella modulistica per facilitare la comprensione. Le descrizioni standard sono &quot;Pagamento a Conguaglio&quot; e &quot;Pagamento Diretto&quot;.</rdfs:comment>
        <rdfs:label xml:lang="it">descrizione tipo pagamento CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagEsenzione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagEsenzione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MassimaleCISOA"/>
        <rdfs:comment>Identifica la proprietà booleana che indica se una specifica causale è esente o meno dall&apos;applicazione del limite massimo. Ad esempio, i trattamenti per &quot;intemperie stagionali&quot; sono esenti, mentre quelli per &quot;eccezionali calamità&quot; ne sono soggetti.</rdfs:comment>
        <rdfs:label xml:lang="it">flag esenzione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagLavoratoreMensilizzato -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagLavoratoreMensilizzato">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Rappresenta la proprietà tecnica che indica se il lavoratore è soggetto a retribuzione mensile oppure no.</rdfs:comment>
        <rdfs:label xml:lang="it">flag lavoratore mensilizzato</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagMassimaleCausaleCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagMassimaleCausaleCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CausaleCISOA"/>
        <rdfs:comment>Rappresenta un indicatore tecnico che specifica se, per una determinata motivazione di sospensione dell&apos;attività lavorativa, sia previsto o meno l&apos;utilizzo di un tetto massimo (massimale) all&apos;erogazione della prestazione. Questa proprietà può assumere i valori &quot;S&quot; (Sì) o &quot;N&quot; (No) e la sua funzione è fondamentale per guidare il motore di calcolo dell&apos;INPS nella determinazione dell&apos;importo dell&apos;integrazione salariale lorda spettante ai beneficiari.</rdfs:comment>
        <rdfs:label xml:lang="it">flag massimale causale CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPensionatoLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPensionatoLavoratoreInteressatoCISOA">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indica un indicatore che specifica se il lavoratore è titolare di un trattamento pensionistico. Può assumere i valori &quot;S&quot; (Sì) o &quot;N&quot; (No) ed è rilevante per determinare l&apos;importo di eventuali trattenute giornaliere da applicare sulla prestazione.</rdfs:comment>
        <rdfs:label xml:lang="it">flag pensionato lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPresenzaMembro -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagPresenzaMembro">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MembroCommissioneProvinciale"/>
        <rdfs:comment>È un indicatore booleano che traccia l&apos;effettiva partecipazione di un componente a una specifica riunione di commissione. Può assumere i valori &quot;S&quot; (Sì) o &quot;N&quot; (No). La corretta valorizzazione di questo flag è indispensabile per la validità legale della seduta e per la produzione della &quot;Lettera per la Ragioneria&quot;.</rdfs:comment>
        <rdfs:label xml:lang="it">flag presenza membro</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagSospensioneIstruttoria -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagSospensioneIstruttoria">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <rdfs:comment>È una proprietà di tipo booleano o di stato che indica se l&apos;attività di verifica tecnica su un singolo beneficiario è stata temporaneamente congelata dall&apos;Operatore di Sede. All&apos;interno dell&apos;applicativo, l&apos;operatore può inserire la spunta di &quot;Sospesa&quot; per segnalare la necessità di approfondimenti istruttori o per attendere l&apos;esito di controlli asincroni critici, come la verifica di titolarità dell&apos;IBAN (che può richiedere fino a tre giorni). Finché questo flag è attivo, la domanda rimane nello stato tecnico di &quot;Sospesa&quot; e il sistema non permette il passaggio alla fase finale di trasmissione o di effettuare ulteriori modifiche.</rdfs:comment>
        <rdfs:label xml:lang="it">flag sospensione istruttoria</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagVisibileCausaleCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/flagVisibileCausaleCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CausaleCISOA"/>
        <rdfs:comment>E&apos; un indicatore di sistema (Sì/No) utilizzato per gestire la visibilità della causale all&apos;interno dell&apos;applicazione web. Permette agli amministratori del sistema di rendere una causale selezionabile dalle aziende durante la fase di compilazione della domanda o di nasconderla qualora non sia più attiva o applicabile (come nel caso delle causali legate a decreti emergenziali scaduti).</rdfs:comment>
        <rdfs:label xml:lang="it">flag visibile causale CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/giornateAccolteLavoratore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/giornateAccolteLavoratore">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <rdfs:comment>Rappresenta il numero di giornate di sospensione effettivamente validate dall&apos;Operatore di Sede per il pagamento a un singolo lavoratore. Il valore viene determinato durante la fase di istruttoria individuale e non può essere superiore al numero di giorni approvato dalla Commissione Provinciale per l&apos;azienda.</rdfs:comment>
        <rdfs:label xml:lang="it">giornate accolte lavoratore</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/giornateRespinteLavoratore -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/giornateRespinteLavoratore">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/IstruttoriaCISOA"/>
        <rdfs:comment>Identifica il numero di giornate di integrazione salariale richieste dall&apos;azienda ma negate dall&apos;INPS in fase di istruttoria tecnica per lo specifico lavoratore. Questa proprietà viene valorizzata qualora l&apos;operatore riscontri anomalie o incompatibilità soggettive (es. lavoratore pensionato, decesso o mancato raggiungimento del requisito delle 181 giornate). In caso di valorizzazione di questa proprietà, l&apos;operatore è tenuto a inserire una causale di reiezione individuale nel sistema.</rdfs:comment>
        <rdfs:label xml:lang="it">giornate respinte lavoratore</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/importoTrattenuta -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/importoTrattenuta">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TrattenutaSindacalePrestazioneCISOA"/>
        <rdfs:comment>Identifica la proprietà di tipo decimale che indica il valore monetario esatto della trattenuta da sottrarre alla prestazione spettante al beneficiario.</rdfs:comment>
        <rdfs:label xml:lang="it">importo trattenuta</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>Rappresenta l&apos;ubicazione fisica esatta (recapito) del fondo agricolo o del cantiere dove viene svolta l&apos;attività lavorativa e dove si è verificato l&apos;evento che ha causato la sospensione.</rdfs:comment>
        <rdfs:label xml:lang="it">indirizzo del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoEmailAziendaAgricola -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/indirizzoEmailAziendaAgricola">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola"/>
        <rdfs:comment>Identifica l&apos;indirizzo email dell&apos;azienda agricola</rdfs:comment>
        <rdfs:label xml:lang="it">indirizzo email azienda agricola</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/matricolaOperatoreDiSede -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/matricolaOperatoreDiSede">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/OperatoreDiSedeINPS"/>
        <rdfs:comment>Identifica in modo univoco il codice identificativo (matricola) del funzionario INPS che ha effettuato la lavorazione della pratica.</rdfs:comment>
        <rdfs:label xml:lang="it">matricola operatore di sede</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/nomeAllegato -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/nomeAllegato">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DocumentoAllegatoCISOA"/>
        <rdfs:comment>Rappresenta il nome del file elettronico caricato a corredo della domanda CISOA.</rdfs:comment>
        <rdfs:label xml:lang="it">nome allegato</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/noteEsitoIstruttoria -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/noteEsitoIstruttoria">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/EsitoIstruttoriaCISOA"/>
        <rdfs:comment>Rappresenta il campo testuale utilizzato dall&apos;Operatore di Sede per inserire annotazioni, giustificazioni o commenti tecnici relativi alla decisione assunta sul singolo lavoratore. Il suo utilizzo è obbligatorio in caso di reiezione individuale dell&apos;istruttoria: l&apos;operatore deve infatti motivare la negazione del pagamento qualora i controlli di compatibilità o le verifiche sui requisiti abbiano dato esito negativo.</rdfs:comment>
        <rdfs:label xml:lang="it">note esito istruttoria</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroBeneficiariDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroBeneficiariDomandaCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Il numero beneficiari domanda CISOA, indica il totale dei lavoratori (operai o impiegati agricoli) inseriti dall&apos;azienda all&apos;interno della singola domanda di concessione.</rdfs:comment>
        <rdfs:label xml:lang="it">numero beneficiari domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDipendentiCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDipendentiCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>Rappresenta il numero complessivo di lavoratori (operai, impiegati e quadri) effettivamente in forza presso lo specifico cantiere o fondo agricolo oggetto della domanda. Si tratta di un dato statistico e ispettivo fondamentale, poiché permette all&apos;INPS di verificare la coerenza tra la forza lavoro totale dell&apos;unità lavorativa e il numero di beneficiari per i quali viene richiesta l&apos;integrazione salariale.</rdfs:comment>
        <rdfs:label xml:lang="it">numero dipendenti del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDomandaCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroDomandaCISOA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/DomandaCISOA"/>
        <rdfs:comment>Identifica il codice numerico univoco assegnato alla pratica dalla sede INPS territorialmente competente al momento dell&apos;acquisizione. Questa proprietà è solitamente composta dalle ultime due cifre dell&apos;anno solare seguite da un numero progressivo (es. 220052). A differenza del protocollo telematico nazionale, questo numero è il riferimento principale utilizzato dagli operatori di sede per la gestione del fascicolo cartaceo, la ricerca a sistema e il legame della domanda ai verbali della Commissione.</rdfs:comment>
        <rdfs:label xml:lang="it">numero domanda CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniAssenzaLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniAssenzaLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Rappresenta il numero complessivo di giorni di assenza del lavoratore (per motivi quali malattia, maternità, infortunio, ecc.) verificatisi in concomitanza con i periodi di sospensione dell&apos;attività lavorativa. </rdfs:comment>
        <rdfs:label xml:lang="it">numero giorni assenza lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniIntegrazioneSalarialeRichiestaLavoratoreInteressatoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniIntegrazioneSalarialeRichiestaLavoratoreInteressatoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/LavoratoreInteressatoCISOA"/>
        <rdfs:comment>Indica il numero totale di giornate di integrazione salariale richieste dall&apos;azienda per lo specifico lavoratore. Tale valore non può essere superiore al numero totale di giorni di sospensione dell&apos;attività lavorativa indicati nella domanda.</rdfs:comment>
        <rdfs:label xml:lang="it">numero giorni integrazione salariale richiesta lavoratore interessato CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniSospensione -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/numeroGiorniSospensione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/PeriodoSospensione"/>
        <rdfs:comment>Indica la quantità totale di giornate lavorative per le quali l&apos;azienda richiede l&apos;integrazione salariale all&apos;interno del periodo di fermo indicato. È importante notare che, per il calcolo di questo valore, il sistema informativo INPS applica una logica automatica che esclude dal computo le domeniche e le festività nazionali ricadenti nel periodo di sospensione.</rdfs:comment>
        <rdfs:label xml:lang="it">numero giorni sospensione</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/provinciaCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/provinciaCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>Rappresenta la sigla della provincia in cui è ubicato il fondo agricolo o il cantiere dove si è verificato l&apos;evento di sospensione.</rdfs:comment>
        <rdfs:label xml:lang="it">provincia del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneAziendaAgricola">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/AziendaAgricola"/>
        <rdfs:comment>La regione dell&apos;azienda agricola rappresenta un&apos;entità geografico-amministrativa fondamentale per determinare la competenza territoriale e l&apos;applicabilità di specifiche tutele emergenziali.</rdfs:comment>
        <rdfs:label xml:lang="it">regione azienda agricola</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneCantiereOFondo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/regioneCantiereOFondo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/CantiereOFondo"/>
        <rdfs:comment>La regione dell&apos;unita produttiva rappresenta un&apos;entità geografico-amministrativa fondamentale per determinare l&apos;applicabilità di specifiche tutele emergenziali.</rdfs:comment>
        <rdfs:label xml:lang="it">regione del cantiere o fondo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/statoControllo -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/statoControllo">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ControlloDiCompatibilitaCISOA"/>
        <rdfs:comment>Rappresenta la condizione in cui si trovano le verifiche automatiche effettuate dal sistema INPS interrogando banche dati esterne per ogni singolo lavoratore beneficiario. Tale controllo avviene in modalità asincrona e il suo esito è un prerequisito fondamentale per l&apos;avanzamento del processo.</rdfs:comment>
        <rdfs:label xml:lang="it">stato controllo</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoMassimale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoMassimale">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MassimaleCISOA"/>
        <rdfs:comment>Proprietà che distingue tra le diverse tipologie di tetto massimo previste dalla legge di Bilancio 2022 (L. 234/2021).</rdfs:comment>
        <rdfs:label xml:lang="it">tipo massimale</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoRicorsoCISOA -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoRicorsoCISOA">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/RicorsoCISOA"/>
        <rdfs:comment>Identifica la categoria del soggetto che ha proposto l&apos;impugnazione contro il provvedimento della Commissione Provinciale. I valori ammessi sono codificati come segue:A (Azienda): identifica i ricorsi presentati dal datore di lavoro agricolo contro la reiezione (totale o parziale) della domanda.L (Lavoratore): identifica i ricorsi presentati dai singoli operai agricoli interessati dalla prestazione.S (INPS/Amministrazione): identifica i ricorsi presentati dai componenti della Commissione Provinciale (incluso il Direttore di Sede o suo delegato) che abbiano manifestato il proprio dissenso durante la votazione e abbiano richiesto l&apos;inserimento a verbale della motivazione.</rdfs:comment>
        <rdfs:label xml:lang="it">tipo ricorso CISOA</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoTrattenuta -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/tipoTrattenuta">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/TrattenutaSindacalePrestazioneCISOA"/>
        <rdfs:comment>Specifica la natura del calcolo della ritenuta. Può assumere i valori &apos;N&apos; se applicata sul valore netto della prestazione o &apos;L&apos; se applicata sull&apos;importo lordo.</rdfs:comment>
        <rdfs:label xml:lang="it">tipo trattenuta</rdfs:label>
    </owl:DatatypeProperty>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valoreMassimale -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/valoreMassimale">
        <rdfs:domain rdf:resource="https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/MassimaleCISOA"/>
        <rdfs:comment>Proprietà numerica che riporta il limite monetario annuo stabilito dall&apos;INPS (tramite circolari dedicate) per la liquidazione delle prestazioni soggette a tetto.</rdfs:comment>
        <rdfs:label xml:lang="it">valore massimale</rdfs:label>
    </owl:DatatypeProperty>



