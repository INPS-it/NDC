        <rdfs:label xml:lang="it">Soglia retribuzione giornaliera</rdfs:label>
    </owl:NamedIndividual>



    <!-- https://w3id.org/italia/social-security/onto/wageSubsidySchemeForAgriculturalWorkers/ValidazioneCodiceFiscaleSuARCA -->

